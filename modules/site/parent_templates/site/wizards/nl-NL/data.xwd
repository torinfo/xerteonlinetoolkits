			<passwordError label="Error bericht" type="TextArea" height="50" optional="true" defaultValue="Invalid access code" tooltip="THet error bericht dat verschijnt wanneer een onjuiste toeganscode wordt ingevoerd"/>
			<passwordSubmit label="Label knop" type="TextInput" optional="true" defaultValue="Inleveren" tooltip="Het label op de toegangscode inleverknop"/>
