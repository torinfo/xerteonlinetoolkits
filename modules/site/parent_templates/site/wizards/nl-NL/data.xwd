			<hideOnTime label="Van (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
