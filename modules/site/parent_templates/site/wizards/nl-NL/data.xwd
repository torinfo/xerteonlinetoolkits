                			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                			<hideUntilTime label="Tot (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                		</hideShow>

	</pdf><canvas icon="icPallette" menuItem="Canvas" remove="true" advanced="true">

		<name type="TextInput" label="Titel" wysiwyg="true"/>
		<id type="TextInput" label="ID" placeholder="Voeg de ID hier toe" tooltip="De HTML-id die aan het canvas-element wordt toegewezen."/>
		<width type="TextInput" label="Breedte"/>
		<height type="TextInput" label="Hoogte"/>
		<showTitle label="Toon titel" type="CheckBox" defaultValue="false" mandatory="true"/>
		
		<class type="TextInput" label="Class" optional="true" tooltip="De namen van alle CSS-klassen die aan het canvas-element worden toegewezen."/>
		<style type="TextInput" label="Stijlen" optional="true" tooltip="CSS-stijlen die inline op het canvas-element worden toegepast."/>

		<hideShow type="group" label="Verberg/Toon canvas" optional="true" tooltip="Verberg het canvas of verberg/toon het canvas tussen de genoemde data." info="Verberg het canvas altijd of gebruik de 'Van' &amp; 'Tot' velden om aan te geven wanneer het canvas beschikbaar is.">
                			<hideContent label="Verberg canvas" type="CheckBox" defaultValue="false" optional="true"/>
                			<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                			<hideOnTime label="Van (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                			<hideUntilTime label="Tot (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                		</hideShow>

	</canvas><script icon="icCog" type="script" height="400" menuItem="Script" label="Script" remove="true" divider="true" advanced="true">

		<name type="TextInput" label="Titel"/>

	</script><image icon="icImage" height="250" menuItem="Afbeelding" remove="true">

		<name type="TextInput" label="Titel" wysiwyg="true"/>
		<imgGroup type="group" label="Afbeelding">
			<url type="Media" label="Bestand" placeholder="Selecteer afbeelding"/>
			<alt type="TextInput" label="Omschrijving" placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
		</imgGroup>
		<showTitle label="Toon titel" type="CheckBox"/>
		<showTitleFix label="Toon titel" type="CheckBox"/>
		<caption label="Onderschrift" type="TextInput" defaultValue="" wysiwyg="true" optional="true" tooltip="Voeg onderschrift toe onder de afbeelding"/>

		<hideShow type="group" label="Verberg/Toon afbeelding" optional="true" tooltip="Verberg de afbeelding of verberg/toon de afbeelding tussen de genoemde data." info="Verberg deze afbeelding altijd of gebruik de 'Van' &amp; 'Tot' velden om aan te geven wanneer de afbeelding beschikbaar is.">
                        			<hideContent label="Verberg afbeelding" type="CheckBox" defaultValue="false" optional="true"/>
                        			<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideOnTime label="Van (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideUntilTime label="Tot (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        		</hideShow>

	</image><audio icon="icSound" height="250" menuItem="Audio" remove="true">

		<name type="TextInput" label="Titel" wysiwyg="true"/>
		<url type="Media" label="Audio" placeholder="Selecteer een audio bestand"/>
		<showTitle label="Toon titel" type="CheckBox"/>
		<showTitleFix label="Toon titel" type="CheckBox"/>
		<transcript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er wordt een transcriptknop toegevoegd aan de audiobalk wanneer transcripttekst is opgenomen"/>

		<hideShow type="group" label="Verberg/Toon audio" optional="true" tooltip="Verberg de audio of verberg/toon de audio ussen de genoemde data." info="Verberg deze audio altijd of gebruik de 'Van' &amp; 'Tot' velden om aan te geven wanneer de audio beschikbaar is.">
                        			<hideContent label="Verberg audio" type="CheckBox" defaultValue="false" optional="true"/>
                        			<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideOnTime label="Van (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideUntilTime label="Tot (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        		</hideShow>

	</audio><video icon="icFilm" height="250" menuItem="Video" remove="true">

		<name type="TextInput" label="Titel" wysiwyg="true"/>
		<url type="Media" label="Video" placeholder="Selecteer een videobestand of voer een url/embedcode in"/>
		<showTitle label="Toon titel" type="CheckBox"/>
		<showTitleFix label="Toon titel" type="CheckBox"/>
		
		<iframeRatio label="iframe beeldverhouding" type="TextInput" placeholder="16:9" tooltip="Beeldverhouding voor videos van externe sites (bijvoorbeeld YouTube, Vimeo, Mediasite)" optional="true"/>

		<hideShow type="group" label="Verberg/Toon video" optional="true" tooltip="Verberg de video of verberg/toon de video tussen de genoemde data." info="Verberg deze video altijd of gebruik de 'Van' &amp; 'Tot' velden om aan te geven wanneer de video beschikbaar is.">
                        			<hideContent label="Verberg video" type="CheckBox" defaultValue="false" optional="true"/>
                        			<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideOnTime label="Van (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideUntilTime label="Tot (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        		</hideShow>

	</video><navigator icon="icPages" menuItem="Navigator" remove="true">

		<name type="TextInput" label="Titel" wysiwyg="true"/>
		<type type="ComboBox" label="Type" options="Accordeon,Carousel,Knoppen,Tabs" data="Accordion,Carousel,Pills,Tabs" width="120" conditionTrigger="true"/>
		<showTitle label="Toon titel" type="CheckBox" defaultValue="false" mandatory="true"/>

		<collapse label="Acordeon inklappen" type="CheckBox" defaultValue="false" optional="true" tooltip="Alle accordeonpanelen standaard ingeklapt " condition="type=='Accordion'"/>
		
		<autoPlayCarousel type="group" label="Automatisch afspelen" optional="true" condition="type=='Carousel'">
			<autoPlay label="Automatisch afspelen" type="CheckBox" defaultValue="true" optional="true" conditionTrigger="true" condition="type=='Carousel'"/>
			<delaySecs label="Vertragen (seconden)" type="NumericStepper" min="1" max="20" step="1" width="100" defaultValue="4" optional="true" condition="type=='Carousel'&amp;&amp;autoPlay=='true'"/>
		</autoPlayCarousel>
		<hideShow type="group" label="Verberg/Toon navigator" optional="true" tooltip="Verberg de navigator of verberg/toon de navigator tussen de genoemde data." info="Verberg deze navigator altijd of gebruik de 'Van' &amp; 'Tot' velden om aan te geven wanneer de navigator beschikbaar is.">
                        			<hideContent label="Verberg navigator" type="CheckBox" defaultValue="false" optional="true"/>
                        			<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideOnTime label="Van (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                        			<hideUntilTime label="Tot (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                        		</hideShow>

		<newNodes>

			<pane><![CDATA[<pane name="Naam"/>]]></pane>

		</newNodes>

	</navigator><pane icon="icPageWhite" remove="true" duplicate="true" menuItem="Paneel">

		<name type="TextInput" label="Paneel titel" wysiwyg="true"/>

		<customPaneLinkGroup type="group" label="Paneel ID" optional="true" tooltip="Maak een aangepaste URL voor dit paneel." info="&lt;p&gt;Maak een link rechtstreeks naar dit navigatorpaneel door een unieke ID toe te voegen en vervolgens #jouwPaneeID toe te voegen aan het einde van de project-URL.&lt;br /&gt;Vermijd het gebruik van spaties en de woorden 'pagina' en 'sectie' in ID's en zorg ervoor dat elke ID uniek is in het hele project.&lt;br /&gt;Houd er ook rekening mee dat ID's hoofdlettergevoelig zijn.&lt;/p&gt;">
            <customLinkID label="Paneel ID" type="TextInput" optional="true"/>
        </customPaneLinkGroup>

		<newNodes>
			
			<xot><![CDATA[<xot name="Titel" showTitleFix="true" link="" header="false" footer="false"/>]]></xot>
			<pdf><![CDATA[<pdf name="Titel" showTitleFix="true" url="" width="500" height="350" openPDF="Open de pdf in een nieuw tabblad"/>]]></pdf>
			<link><![CDATA[<link name="Voeg linktekst toe" url="" target="_self"/>]]></link>
			<video><![CDATA[<video name="Titel" showTitleFix="true" url=""/>]]></video>
			<audio><![CDATA[<audio name="Titel" showTitleFix="true" url=""/>]]></audio>
			<image><![CDATA[<image name="Titel" showTitleFix="true" url="" alt=""/>]]></image>
			<text><![CDATA[<text name="Titel" showTitleFix="true">Voeg tekst toe</text>]]></text>

		</newNodes>
	</pane><xot icon="icXot" menuItem="XOT Project" remove="true">

		<name type="TextInput" label="Titel" wysiwyg="true"/>
		<link type="TextInput" label="Xerte Project link" placeholder="Voeg project url toe" tooltip="De toegangsinstelling van het project mag niet op 'priv&#xE9;' worden gezet."/>
		<header label="Verberg header" type="CheckBox"/>
		<footer label="Verberg Voetbalk" type="CheckBox"/>
		<showTitle label="Toon titel" type="CheckBox"/>
		<showTitleFix label="Toon titel" type="CheckBox"/>
		
		<pageNum label="Pagina" type="TextInput" optional="true" tooltip="Insluiten van een specifieke pagina van het XOT leerobject door een paginanummer of pagina-ID in te voeren."/>

		<dimensions label="Dimensies" type="group" optional="true" tooltip="De afmetingen van het ingesloten leerobject.">
			<width label="Breedte" type="TextInput" placeholder="100%" optional="true"/>
			<height label="Hoogte" type="TextInput" placeholder="600" optional="true"/>
		</dimensions>

		<xotLinkGroup type="group" label="Link toevoegen" optional="true" tooltip="Voeg een link toe om het Xerte leerobject te openen in een lightbox of een nieuw tabblad/venster">
			<showLink label="Toon link" type="CheckBox" conditionTrigger="true" defaultValue="true" optional="true"/>
			<linkText label="Link tekst" type="TextInput" wysiwyg="true" defaultValue="" condition="showLink=='true'" optional="true"/>
			<displayOptions label="Open in" type="ComboBox" data="newwindow,thiswindow,lightbox" options="Nieuw tabblad/venster,Dit tabblad,Lightbox" defaultValue="newwindow" condition="showLink=='true'" optional="true"/>
			<showEmbed label="Insluiten" type="CheckBox" defaultValue="true" condition="showLink=='true'" optional="true" tooltip="Wanneer een link wordt getoond, kan deze optie worden gebruikt om het ingesloten Xerte leerobject van de pagina te verwijderen. Zowel het ingesloten leerobject als de link kunnen indien nodig worden getoond."/>
		</xotLinkGroup>
		<hideShow type="group" label="Toon/Verberg XOT" optional="true" tooltip="Verberg deze XOT of verberg/toon de XOT tussen bepaalde data." info="Verberg deze XOT altijd of gebruik de 'Van' &amp; 'Tot' velden om aan te geven wanneer de XOT beschikbaar is.">
                                			<hideContent label="Verberg XOT" type="CheckBox" defaultValue="false" optional="true"/>
                                			<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                                			<hideOnTime label="Van (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                                			<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
                                			<hideUntilTime label="Tot (uu:mm)" type="TextInput" placeholder="00:00" optional="true"/>
                                		</hideShow>

	</xot></wizard>
