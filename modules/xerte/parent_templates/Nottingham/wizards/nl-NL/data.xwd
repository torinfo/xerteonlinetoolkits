    <nextBtnWidth label="Breedte volgende knop" type="NumericStepper" min="100" max="250" step="10" width="100" defaultValue="100" language="true" deprecated="Breedte is automatisch ingesteld"/>
    <restartBtnText label="Label herstart knop" type="TextInput" wysiwyg="true" language="true"/>
    <restartBtnTip label="Tooltip herstart knop" type="textInput" language="true" deprecated="Deze optie is niet langer vereist"/>
    <restartBtnWidth label="Breedte herstart knop" type="NumericStepper" min="100" max="250" step="10" width="100" defaultValue="100" language="true" deprecated="Breedte is automatisch ingesteld"/>	

	<imgInfo type="group" label="Afbeelding" optional="true">
		<img label="Afbeelding" type="media" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding" optional="true"/>
		<tip label="Omschrijving" type="textInput" optional="true" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
		<caption label="Onderschrift" type="textInput" optional="true" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
	</imgInfo>
	
	<videoInfo type="group" label="Video" optional="true">
