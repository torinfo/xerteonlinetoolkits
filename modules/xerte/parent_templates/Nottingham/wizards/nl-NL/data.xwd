    <panelWidth label="Paneelbreedte" options="Klein,Medium,Groot,Volledig" type="ComboBox" data="Small,Medium,Large,Full" defaultValue="Small" width="100"/>
	<randomise label="Willekeurige volgorde" type="checkBox"/>
	<showText label="Toon tekst knop" type="TextInput" wysiwyg="true" language="true"/>
	<trackedShowText label="Toon de knop tekst bij tracking" type="TextInput" wysiwyg="true" language="true"/>
	<correctText label="Juiste tekst" type="TextInput" wysiwyg="true" language="true"/>
	<incorrectText label="Onjuiste tekst" type="TextInput" wysiwyg="true" language="true"/>
	<nextText label="Tekst volgende knop" type="TextInput" wysiwyg="true" language="true"/>
	<restartText label="Tekst herstart knop" type="TextInput" wysiwyg="true" language="true"/>
	<countText label="Fragment {i} van {n}" type="TextInput" wysiwyg="true" language="true"/>
	<answerFieldLabel label="Antwoordveld verborgen Aria-Label" type="TextInput" wysiwyg="false" language="true" mandatory="true" defaultValue="Antwoord" tooltip="Dit is een verborgen label specifiek voor gebruikers van screenreaders, zodat het tekstveld waarin ze moeten reageren gelabeld is en het label door de screenreader wordt uitgesproken. Bijvoorbeeld: Antwoord."/>
	
	<showCorrectness label="Toon juistheid" type="checkBox" optional="true" defaultValue="false" tooltip="Markeer het antwoord als juist of onjuist."/>
	<trackingWeight label="Tracking score weging" optional="true" type="textInput" width="120" defaultValue="1.0" tooltip="Pas de weging van de opdracht op deze pagina aan, ten opzichte van andere gescoorde pagina's in het leerobject. Als je de weging instelt op 0, betekent dit dat de opdracht op deze pagina niet meetelt de totaalscore van het leerobject."/>

	<tt type="group" label="Timed tekst" optional="true">
