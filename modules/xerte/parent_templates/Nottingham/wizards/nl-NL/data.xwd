    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></iSpring><imageCompare menu="Media" menuItem="Afbeelding vergelijker" hint="Hiermee kun je twee afbeeldingen vergelijken." icon="icImageCompare" thumb="thumbs/imageCompare.jpg" example="https://xot.xerte.org.uk/play_164#afbeeldingvergelijker" wiki="https://xerte.org.uk/wiki/doku.php?id=media_image_compare_page" remove="true">

	<name label="Titel pagina" type="TextInput" wysiwyg="true"/>
	
	<text label="Tekst" type="TextArea" wysiwyg="true" placeholder="Voeg paginatekst toe" condition="imageSize!='100'"/>
	<textPosition label="Tekst uitlijnen" type="ComboBox" condition="imageSize!='100'" options="Links,Rechts,Top,Bottom" data="top,left"/>

	<imageSize label="Afbeelding grootte" type="ComboBox" options="Klein,Medium,Groot,Volledig" data="40,60,80,100" defaultValue="60" conditionTrigger="true"/>
	
	<image1 type="group" label="Afbeelding 1">
		<url1 label="Bestand" type="media" placeholder="Selecteer afbeelding"/>
		<tip1 label="Omschrijving" type="TextInput" placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
	</image1>
	
	<image2 type="group" label="Afbeelding 2">
		<url2 label="Bestand" type="media" placeholder="Selecteer afbeelding"/>
		<tip2 label="Omschrijving" type="TextInput" placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
	</image2>

	<sliderPosition label="Positie schuifbalk" type="ComboBox" data="horizontal,vertical" options="Horizontaal,Verticaal" defaultValue="horizontal" optional="true"/>

  <resources label="Bronnen bestanden / links" type="DataGrid" gridTxt="&lt;p&gt;Bronnen kunnen URL's, ge&#xFC;ploade bestanden of andere pagina's binnen deze pagina of leerobject zijn.&lt;br /&gt;Voer een URL in, upload een bestand naar het bronveld of selecteer een pagina in het dropdownmenu 'Xerte-paginalink'.&lt;/p&gt;" columns="4" colWidths="20,15,15,50" editable="1,1,1,1" cellType="textInput,media,pageList,textArea" wysiwyg="false,false,false,true" controls="1" headers="Titel,Bron,Xerte Pagina Link,Beschrijving" newRow=",,," defaultValue="|" optional="true" tooltip="Een lijst met aanvullende bronnen met betrekking tot de pagina-inhoud" common="true"/><narrate type="group" label="Audio" optional="true" tooltip="Voeg een audio player toe aan de onderkant van de pagina" common="true">
		<narration label="Audio bestand" type="media" defaultValue="Selecteer een audiobestand" placeholder="Selecteer een audio bestand" optional="true"/>
		<narrationTranscript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er wordt een transcriptknop toegevoegd aan de audiobalk wanneer transcripttekst is opgenomen"/>    
		<playNarration label="Auto-Play" type="CheckBox" defaultValue="false" optional="true" tooltip="Speel automatisch af wanneer de pagina wordt bekeken. NB.: sommige browsers staan automatisch afspelen niet toe"/>
		<narrationNavigate label="Navigeer aan het einde" type="CheckBox" defaultValue="false" optional="true" tooltip="Ga automatisch naar de volgende pagina wanneer de audio afgelopen is"/>
	</narrate><navSetting label="Navigatie knoppen" options="Alle,Vorige en volgende,Alleen terug,Alleen volgende,Geen" type="ComboBox" width="120" data="all,backnext,backonly,nextonly,none" defaultValue="all" optional="true" deprecated="Deze optie wordt niet meer gebruikt in deze XOT versie. Gebruik de nieuwe groep Navigatie knoppen (optionele eigenschap) om deze in te stellen." common="true"/><navBtns type="group" label="Navigatie knoppen" optional="true" tooltip="Schakel de individuele navigatieknoppen op deze pagina uit" info="Het standaard beschikbaar hebben van alle navigatie knoppen op iedere pagina hangt af van de navigatie instelling van het leerobject. Deactiveer knoppen op de individuele pagina's door deze te selecteren op die pagina." common="true">
		<home label="Home / Menu knop" type="CheckBox" defaultValue="true" optional="true"/>
		<back label="Terug / Vorige knop" type="CheckBox" defaultValue="true" optional="true"/>
		<next label="Volgende knop" type="CheckBox" defaultValue="true" optional="true"/>
		<save label="Sessie opslaan knop" type="CheckBox" defaultValue="true" optional="true"/>
	</navBtns><hideShow type="group" label="Verberg/Toon pagina" optional="true" tooltip="GEEF EEN BESCHRIJVING HIER..." info="Je kunt deze pagina altijd verbergen door de velden 'Van' en 'Tot' leeg te laten. Je kunt ook een datum (en eventueel een tijd) opgeven in de velden 'Van' en 'Tot' om aan te geven wanneer de pagina beschikbaar moet zijn." common="true">
		<hidePage label="Verberg pagina" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideOnTime label="Van (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideOnDate!=''&amp;&amp;hideOnDate!=undefined"/>
		<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideUntilTime label="Tot (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideUntilDate!=''&amp;&amp;hideUntilDate!=undefined"/>
	</hideShow><linkGroup type="group" label="Stand-alone pagina" optional="true" tooltip="Verwijder pagina van menu zodat je alleen via Xertelinks toegang hebt." common="true">
		<linkPage label="Stand-alone" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<linkTarget label="Open in" type="ComboBox" data="same,new,lightbox" options="Zelfde venster,Nieuw venster,Lightbox" defaultValue="lightbox" condition="linkPage=='true'" optional="true" tooltip="Geeft aan hoe de link naar deze pagina wordt geopend"/>
		<headerHide label="Verberg header" type="Checkbox" defaultValue="false" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de headerbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bijvoorbeeld bekijkt in een lightbox."/>
		<footerHide label="Verberg Voetbalk" type="CheckBox" defaultValue="true" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de voetbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bekijkt in een lightbox."/>
		<reqProgress label="Opnemen in de voortgangbalk" type="CheckBox" defaultValue="false" condition="linkPage=='true'&amp;&amp;(treeroot.progressBar!=undefined||treeroot.progressBarType=='true'||((treeroot.progressBarType=='header1'||treeroot.progressBarType=='header2'||treeroot.progressBarType=='header3')&amp;&amp;treeroot.progressSub=='false'))" optional="true" tooltip="Standaard worden stand-alone pagina's uitgesloten van het voltooiings percentage op de voortgangsbalk. Vink deze optie aan om deze pagina wel op te nemen in de voortgang van het leerobject."/>
	</linkGroup><passwordGroup type="group" label="Toegangscode" optional="true" tooltip="De toegang tot deze pagina is beperkt totdat een toegangscode wordt ingevoerd. Let op: om het leerobject veilig te beschermen, moet je de beveiliging regelen via het tabblad Toegang in de leerobject eigenschappen in plaats van deze optionele eigenschap te gebruiken. Deze functie is vooral bedoeld voor het ontsluiten van nieuw materiaal en niet voor beveiliging volgens de AVG." common="true">
		<password label="Toegangscode(s)" type="TextInput" optional="true" defaultValue="" tooltip="Een komma gescheiden lijst met toegangscodes die toegang geven tot deze site"/>
		<passwordCase label="Hoofdletter gevoelig" type="CheckBox" optional="true" defaultValue="true" tooltip="De toegangscodes zijn hoofdletter gevoelig wanneer deze optie is aangevinkt"/>
		<passwordType label="Type" type="ComboBox" data="standard,centered,vault,vaultnumeric" options="Standaard,Standaard midden,Kluis,Toetsenbord" optional="true" defaultValue="standard" tooltip="Pas het uiterlijk van de toegangscode-informatie op de pagina aan. De toegangscode moet numeriek zijn wanneer 'Toetsenbord' wordt gebruikt."/>
		<passwordInfo label="Instructies" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Enter an access code below to view the page:&lt;/p&gt;" tooltip="De instructies die verschijnen in het toegangscode venster"/>
		<passwordError label="Foutmelding" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Invalid access code&lt;/p&gt;" tooltip="De foutmelding die verschijnt wanneer de verkeerde toegangscode wordt gebruikt"/>
		<passwordSubmit label="Label knop" type="TextInput" optional="true" defaultValue="Controleer" tooltip="Het label van de vul toegangscode in knop"/>
	</passwordGroup><introGroup type="group" label="Introductie" optional="true" tooltip="Voeg een Pagina-introductie knop toe aan de voetbalk die informatie in een lightbox opent, wanneer erop wordt geklikt. Deze introductie kan worden ingesteld om automatisch te openen wanneer de pagina voor het eerst wordt geladen." common="true">
		<introType type="ComboBox" label="Content type" defaultValue="text" options="Tekst,Afbeelding,Video,URL,Bestand" data="text,image,video,url,file" conditionTrigger="true" optional="true" tooltip="Het type inhoud dat wordt gebruikt als introductie voor deze pagina"/>
		<pageIntro label="Tekst" type="TextArea" height="100" defaultValue="" condition="introType=='text'||introType==undefined" optional="true"/>
		<introImg label="Afbeelding" type="media" height="100" defaultValue="" condition="introType=='image'" optional="true" placeholder="Selecteer afbeelding"/>
		<introVideo label="Video" type="media" height="100" defaultValue="" condition="introType=='video'" optional="true" placeholder="Selecteer een videobestand of voer een url/embedcode in"/>
		<introTip label="Omschrijving" type="TextInput" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)." condition="introType=='image'||introType=='video'" optional="true"/>
		<introCaption label="Onderschrift" type="TextInput" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" condition="introType=='image'" optional="true" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
		<introURL label="URL" type="TextInput" defaultValue="" condition="introType=='url'" optional="true" placeholder="Voeg een URL toe"/>
		<introFile label="Bestand" type="media" height="100" defaultValue="" condition="introType=='file'" optional="true" placeholder="Selecteer een bestand (bijvoorbeeld een PDF)"/>
		<introTitle type="CheckBox" label="Weergeven titel" defaultValue="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Toon de paginatitel boven de introductietekst"/>
		<introBtn type="CheckBox" label="Start knop" defaultValue="true" conditionTrigger="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Voeg een 'start'-knop toe onder de introductietekst die de lightbox sluit wanneer erop wordt geklikt"/>
		<introBtnTxt label="Tekst knop" type="TextInput" defaultValue="Start" condition="introBtn=='true'&amp;&amp;(introType=='text'||introType==undefined||introType=='image')" wysiwyg="true" optional="true"/>
		<introWidth label="Breedte lightbox" options="Auto,Klein,Medium,Groot,Volledig" type="ComboBox" data="Auto,Small,Medium,Large,Full" defaultValue="Auto" condition="introType=='text'||introType==undefined" optional="true"/>
		<introShow type="ComboBox" label="Open automatisch" defaultValue="first" options="Elke keer dat deze pagina wordt bekeken,De eerste keer dat deze pagina wordt bekeken,Nooit" data="always,first,never" optional="true" tooltip="Geef op of de introductie automatisch wordt geopend wanneer de pagina wordt bekeken"/>
	</introGroup><customLinkGroup type="group" label="Pagina ID" optional="true" tooltip="Maak een aangepaste URL voor deze pagina" info="&lt;p&gt;Maak een directe link naar deze pagina door #jePaginaID toe te voegen aan het einde van de project-URL.&lt;br /&gt;Vermijd het gebruik van spaties, speciale tekens en het woord 'page' in ID's en zorg ervoor dat elke ID uniek is binnen het hele project.&lt;br /&gt;ID's zijn hoofdlettergevoelig.&lt;/p&gt;" common="true">
		<pageID label="Pagina ID" type="TextInput" optional="true"/>
	</customLinkGroup><unmarkForCompletion label="Voltooiing niet verplicht" type="CheckBox" defaultValue="true" tooltip="Wanneer het leerobject wordt getrackt (bijvoorbeeld met behulp van SCORM of xAPI), selecteer 'afronding niet verplicht' wanneer de pagina niet voltooid hoeft te worden, zodat het leerobject als voltooid kan worden gemarkeerd." optional="true" common="true"/><disableGlossary label="Woordenlijst uitzetten" defaultValue="true" type="CheckBox" condition="treeroot.glossary!=undefined" optional="true" tooltip="Voorkom dat woorden uit de woordenlijst op deze pagina worden getoond" common="true"/><styles label="Stijl" type="script" height="200" optional="true" tooltip="Voeg op maat gemaakte CSS toe aan deze pagina" common="true"/><tracking type="group" label="Tracking" optional="true" tooltip="Eigenschappen met betrekking tot tracked leerobjecten (bijvoorbeeld SCORM or xAPI)" common="true">
        <trackinglabel label="Trackinglabel" type="TextInput" wysiwyg="false" optional="true" tooltip="In plaats van paginanummer het label als tracking identifier gebruiken (SCORM en xAPI)"/>
        <grouping label="Track groepering" type="Grouping" optional="true" tooltip="Label voor groepering van xAPI events, om te gebruiken voor groepering in xAPI rapporten"/>
	</tracking><scripts type="group" label="Script" optional="true" tooltip="Voeg JavaScript toe die bij de eerste keer dat deze pagina geladen wordt of iedere keer dat deze pagina geladen wordt, wordt uitgevoerd " common="true">
		<script label="Script" type="script" height="200" defaultValue="// JavaScript / jQuery" optional="true"/>
		<run label="Uitvoeren" options="Alleen de eerste keer dat de pagina wordt bekeken,Iedere keer dat de pagina wordt bekeken" type="ComboBox" width="120" data="first,all" defaultValue="first" optional="true"/>
	</scripts><background type="group" label="Achtergrond" optional="true" tooltip="Voeg een achtergrondafbeelding toe aan deze pagina. Dit overschrijft elke achtergrondafbeelding die op leerobjectniveau is toegevoegd." common="true">
		<bgImage label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<backgroundFit optional="true" type="ComboBox" options="Uitrekken om te passen,Bijsnijden om te passen,Hele afbeelding tonen" data="fill,cover,contain" defaultValue="cover" label="Afbeelding schaal" tooltip="Hoe de achtergrondafbeelding de beschikbare ruimte vult. 'Uitrekken om te passen' zal de afbeelding verticaal of horizontaal uitrekken om de ruimte te vullen, 'Bijsnijden om te passen' zal de afbeelding bijsnijden om te passen zonder deze te vervormen en 'Hele afbeelding weergeven' zal de volledige geschaalde afbeelding weergeven zonder deze te vervormen. Let op: dit heeft geen effect in Internet Explorer."/>
		<bgImageAlpha label="Doorzichtigheid" type="NumericStepper" min="0" max="100" step="10" defaultValue="30" optional="true" tooltip="De dekking van de afbeelding, waarbij 0 volledig transparant is en 100 helemaal niet transparant is."/>
		<bgImageDark optional="true" type="NumericStepper" min="0" max="100" step="1" defaultValue="0" label="Donkerheid" tooltip="Voeg een filter toe om de afbeelding donkerder te maken. 0 is niet donker en 100 is volledig donker (zwart)."/>
		<bgImageGrey optional="true" type="CheckBox" label="Grijsschaal" defaultValue="false" tooltip="Voeg een filter toe om de kleur van de afbeelding te veranderen naar een grijsschaal."/>
	</background><pageTimer type="group" label="Pagina timer" optional="true" tooltip="Voeg een timer toe aan de pagina, tel terug naar 0" common="true">
		<showTimer label="Toon timer" optional="true" type="CheckBox" defaultValue="true" conditionTrigger="true"/>
		<timer label="Toon limiet (seconden)" defaultValue="60" type="NumericStepper" min="0" step="1" width="100" condition="showTimer=='true'" optional="true"/>
		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
		<lightbox type="CheckBox" label="Lightbox afbeeldingen" defaultValue="true" conditionTrigger="true" optional="true"/>
		<lightboxCaption type="ComboBox" label="Onderschrift" defaultValue="false" condition="lightbox=='true'" optional="true" options="Geen,Onder afbeelding,Boven afbeelding" data="false,below,above" tooltip="Voeg een onderschrift toe aan lightbox-afbeeldingen op deze pagina. De onderschrifttekst is afkomstig uit de velden 'Beschrijving' of 'Alt-tekst'."/>
	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></imageCompare><imageSequence menu="Media" menuItem="Afbeelding reeks" hint="Een pagina die een reeks afbeeldingen achterelkaar in een animatie zet. De reeks met afbeeldingen kan afzonderlijk worden getoond of met anderen worden gegroepeerd in casussen." icon="icImages" thumb="thumbs/imageSequence.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#afbeeldingreeks" wiki="https://xerte.org.uk/wiki/doku.php?id=media_image_sequence" remove="true" deepLink="true">
    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
	<text label="Pagina tekst" type="TextArea" height="300" width="380" placeholder="Voeg paginatekst toe"/>
    <align label="Afbeelding positie" options="Links,Rechts" type="ComboBox" data="left,right" width="100"/>
	<imgSize label="Afbeelding grootte" options="Auto,Volledig scherm" type="ComboBox" data="auto,full" width="100" tooltip="Als deze is ingesteld op Volledig scherm, worden de afbeeldingen zo groot mogelijk weergegeven - zelfs als dit betekent dat ze groter zijn dan de oorspronkelijke afbeelding."/>
	
	<load label="Afbeelding laden" type="TextInput" wysiwyg="true" language="true"/>
	<load2 label="Series laden" type="TextInput" wysiwyg="true" language="true"/>
	<resetLabel label="Label herstart" type="TextInput" language="true"/>
	<playLabel label="Label afspelen" type="TextInput" language="true"/>
	<pauseLabel label="Label pauze" type="TextInput" language="true"/>
	<infoLabel label="Label info" type="TextInput" language="true"/>
	<magnifyLabel label="Label vergrootglas" type="TextInput" language="true"/>
	<backLabel label="Label terug" type="TextInput" language="true"/>
	<fwdLabel label="Label vooruit" type="TextInput" language="true"/>
	<viewLabel label="Label toon" type="TextInput" language="true"/>
	<caseLabel label="Label casus" type="TextInput" language="true"/>
	
	<controlsGroup type="group" label="Controle knoppen" optional="true" tooltip="Schakel de knoppen onder de serie of afbeelding in/uit">
		
		<reset label="Herstart" type="checkbox" defaultValue="true" optional="true" tooltip="Een knop om naar de eerste afbeelding in de serie terug te gaan"/>
		
		<play label="Afspelen" type="checkbox" defaultValue="true" conditionTrigger="true" optional="true" tooltip="Een knop om de series af te spelen"/>
		<playSpeed label="Afspeelsnelheid" type="NumericStepper" min="0.01" max="5" step="0.01" defaultValue="0.1" condition="play!='false'" optional="true" tooltip="De lengte in tijd (in seconden) dat iedere afbeelding getoond wordt wanneer de animatie afgespeeld wordt"/>

		<magnifier label="Vergrootglas" type="checkbox" defaultValue="true" conditionTrigger="true" optional="true" tooltip="Een knop om een vergrootglas te tonen geven die inzoomt op een gebied terwijl je met de muis over de afbeelding gaat"/>
		<magnifierSize label="Grootte vergrootglas" type="NumericStepper" min="50" max="500" step="10" defaultValue="100" condition="magnifier!='false'" optional="true" tooltip="De grootte van het vergrootglas in pixels"/>
		<magnifierForce label="Vergroting forceren" type="checkbox" defaultValue="false" condition="magnifier!='false'" optional="true" tooltip="Standaard (wanneer de afbeeldingsgrootte op automatisch staat) werkt de vergroting alleen wanneer de afbeelding wordt weergegeven op &amp;lt;80% van de oorspronkelijke afbeeldingsgrootte. Als je de vergroting forceert, werkt het vergrootglas altijd, zelfs als het vergrote beeld groter is dan het origineel en er wazig uit kan zien"/>
		
	</controlsGroup>
	
	<thumbH label="Miniatuurafbeeldingbalk grootte" type="ComboBox" options="Klein,Medium,Groot" data="small,medium,large" defaultValue="medium" width="200" optional="true" tooltip="De grootte van de miniatuurafbeelding afbeeldingen in de menubalk"/>
	
	<viewGroup type="group" label="Bekijk menu" optional="true" tooltip="Wanneer een leerobject meer dan &#xE9;&#xE9;n serie of afbeelding bevat, kunt je met het weergavemenu meerderen tegelijk op het scherm weergeven.">
		<view label="Toon" type="checkbox" defaultValue="true" optional="true"/>
		<viewNum label="Max" type="NumericStepper" min="2" max="4" step="1" defaultValue="4" optional="true"/>
	</viewGroup>
	
    <newNodes>
      <case><![CDATA[<imgGroup name="Case Name" txt=""/>]]></case>
	</newNodes>

  <resources label="Bronnen bestanden / links" type="DataGrid" gridTxt="&lt;p&gt;Bronnen kunnen URL's, ge&#xFC;ploade bestanden of andere pagina's binnen deze pagina of leerobject zijn.&lt;br /&gt;Voer een URL in, upload een bestand naar het bronveld of selecteer een pagina in het dropdownmenu 'Xerte-paginalink'.&lt;/p&gt;" columns="4" colWidths="20,15,15,50" editable="1,1,1,1" cellType="textInput,media,pageList,textArea" wysiwyg="false,false,false,true" controls="1" headers="Titel,Bron,Xerte Pagina Link,Beschrijving" newRow=",,," defaultValue="|" optional="true" tooltip="Een lijst met aanvullende bronnen met betrekking tot de pagina-inhoud" common="true"/><narrate type="group" label="Audio" optional="true" tooltip="Voeg een audio player toe aan de onderkant van de pagina" common="true">
		<narration label="Audio bestand" type="media" defaultValue="Selecteer een audiobestand" placeholder="Selecteer een audio bestand" optional="true"/>
		<narrationTranscript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er wordt een transcriptknop toegevoegd aan de audiobalk wanneer transcripttekst is opgenomen"/>    
		<playNarration label="Auto-Play" type="CheckBox" defaultValue="false" optional="true" tooltip="Speel automatisch af wanneer de pagina wordt bekeken. NB.: sommige browsers staan automatisch afspelen niet toe"/>
		<narrationNavigate label="Navigeer aan het einde" type="CheckBox" defaultValue="false" optional="true" tooltip="Ga automatisch naar de volgende pagina wanneer de audio afgelopen is"/>
	</narrate><navSetting label="Navigatie knoppen" options="Alle,Vorige en volgende,Alleen terug,Alleen volgende,Geen" type="ComboBox" width="120" data="all,backnext,backonly,nextonly,none" defaultValue="all" optional="true" deprecated="Deze optie wordt niet meer gebruikt in deze XOT versie. Gebruik de nieuwe groep Navigatie knoppen (optionele eigenschap) om deze in te stellen." common="true"/><navBtns type="group" label="Navigatie knoppen" optional="true" tooltip="Schakel de individuele navigatieknoppen op deze pagina uit" info="Het standaard beschikbaar hebben van alle navigatie knoppen op iedere pagina hangt af van de navigatie instelling van het leerobject. Deactiveer knoppen op de individuele pagina's door deze te selecteren op die pagina." common="true">
		<home label="Home / Menu knop" type="CheckBox" defaultValue="true" optional="true"/>
		<back label="Terug / Vorige knop" type="CheckBox" defaultValue="true" optional="true"/>
		<next label="Volgende knop" type="CheckBox" defaultValue="true" optional="true"/>
		<save label="Sessie opslaan knop" type="CheckBox" defaultValue="true" optional="true"/>
	</navBtns><hideShow type="group" label="Verberg/Toon pagina" optional="true" tooltip="GEEF EEN BESCHRIJVING HIER..." info="Je kunt deze pagina altijd verbergen door de velden 'Van' en 'Tot' leeg te laten. Je kunt ook een datum (en eventueel een tijd) opgeven in de velden 'Van' en 'Tot' om aan te geven wanneer de pagina beschikbaar moet zijn." common="true">
		<hidePage label="Verberg pagina" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideOnTime label="Van (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideOnDate!=''&amp;&amp;hideOnDate!=undefined"/>
		<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideUntilTime label="Tot (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideUntilDate!=''&amp;&amp;hideUntilDate!=undefined"/>
	</hideShow><linkGroup type="group" label="Stand-alone pagina" optional="true" tooltip="Verwijder pagina van menu zodat je alleen via Xertelinks toegang hebt." common="true">
		<linkPage label="Stand-alone" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<linkTarget label="Open in" type="ComboBox" data="same,new,lightbox" options="Zelfde venster,Nieuw venster,Lightbox" defaultValue="lightbox" condition="linkPage=='true'" optional="true" tooltip="Geeft aan hoe de link naar deze pagina wordt geopend"/>
		<headerHide label="Verberg header" type="Checkbox" defaultValue="false" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de headerbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bijvoorbeeld bekijkt in een lightbox."/>
		<footerHide label="Verberg Voetbalk" type="CheckBox" defaultValue="true" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de voetbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bekijkt in een lightbox."/>
		<reqProgress label="Opnemen in de voortgangbalk" type="CheckBox" defaultValue="false" condition="linkPage=='true'&amp;&amp;(treeroot.progressBar!=undefined||treeroot.progressBarType=='true'||((treeroot.progressBarType=='header1'||treeroot.progressBarType=='header2'||treeroot.progressBarType=='header3')&amp;&amp;treeroot.progressSub=='false'))" optional="true" tooltip="Standaard worden stand-alone pagina's uitgesloten van het voltooiings percentage op de voortgangsbalk. Vink deze optie aan om deze pagina wel op te nemen in de voortgang van het leerobject."/>
	</linkGroup><passwordGroup type="group" label="Toegangscode" optional="true" tooltip="De toegang tot deze pagina is beperkt totdat een toegangscode wordt ingevoerd. Let op: om het leerobject veilig te beschermen, moet je de beveiliging regelen via het tabblad Toegang in de leerobject eigenschappen in plaats van deze optionele eigenschap te gebruiken. Deze functie is vooral bedoeld voor het ontsluiten van nieuw materiaal en niet voor beveiliging volgens de AVG." common="true">
		<password label="Toegangscode(s)" type="TextInput" optional="true" defaultValue="" tooltip="Een komma gescheiden lijst met toegangscodes die toegang geven tot deze site"/>
		<passwordCase label="Hoofdletter gevoelig" type="CheckBox" optional="true" defaultValue="true" tooltip="De toegangscodes zijn hoofdletter gevoelig wanneer deze optie is aangevinkt"/>
		<passwordType label="Type" type="ComboBox" data="standard,centered,vault,vaultnumeric" options="Standaard,Standaard midden,Kluis,Toetsenbord" optional="true" defaultValue="standard" tooltip="Pas het uiterlijk van de toegangscode-informatie op de pagina aan. De toegangscode moet numeriek zijn wanneer 'Toetsenbord' wordt gebruikt."/>
		<passwordInfo label="Instructies" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Enter an access code below to view the page:&lt;/p&gt;" tooltip="De instructies die verschijnen in het toegangscode venster"/>
		<passwordError label="Foutmelding" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Invalid access code&lt;/p&gt;" tooltip="De foutmelding die verschijnt wanneer de verkeerde toegangscode wordt gebruikt"/>
		<passwordSubmit label="Label knop" type="TextInput" optional="true" defaultValue="Controleer" tooltip="Het label van de vul toegangscode in knop"/>
	</passwordGroup><introGroup type="group" label="Introductie" optional="true" tooltip="Voeg een Pagina-introductie knop toe aan de voetbalk die informatie in een lightbox opent, wanneer erop wordt geklikt. Deze introductie kan worden ingesteld om automatisch te openen wanneer de pagina voor het eerst wordt geladen." common="true">
		<introType type="ComboBox" label="Content type" defaultValue="text" options="Tekst,Afbeelding,Video,URL,Bestand" data="text,image,video,url,file" conditionTrigger="true" optional="true" tooltip="Het type inhoud dat wordt gebruikt als introductie voor deze pagina"/>
		<pageIntro label="Tekst" type="TextArea" height="100" defaultValue="" condition="introType=='text'||introType==undefined" optional="true"/>
		<introImg label="Afbeelding" type="media" height="100" defaultValue="" condition="introType=='image'" optional="true" placeholder="Selecteer afbeelding"/>
		<introVideo label="Video" type="media" height="100" defaultValue="" condition="introType=='video'" optional="true" placeholder="Selecteer een videobestand of voer een url/embedcode in"/>
		<introTip label="Omschrijving" type="TextInput" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)." condition="introType=='image'||introType=='video'" optional="true"/>
		<introCaption label="Onderschrift" type="TextInput" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" condition="introType=='image'" optional="true" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
		<introURL label="URL" type="TextInput" defaultValue="" condition="introType=='url'" optional="true" placeholder="Voeg een URL toe"/>
		<introFile label="Bestand" type="media" height="100" defaultValue="" condition="introType=='file'" optional="true" placeholder="Selecteer een bestand (bijvoorbeeld een PDF)"/>
		<introTitle type="CheckBox" label="Weergeven titel" defaultValue="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Toon de paginatitel boven de introductietekst"/>
		<introBtn type="CheckBox" label="Start knop" defaultValue="true" conditionTrigger="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Voeg een 'start'-knop toe onder de introductietekst die de lightbox sluit wanneer erop wordt geklikt"/>
		<introBtnTxt label="Tekst knop" type="TextInput" defaultValue="Start" condition="introBtn=='true'&amp;&amp;(introType=='text'||introType==undefined||introType=='image')" wysiwyg="true" optional="true"/>
		<introWidth label="Breedte lightbox" options="Auto,Klein,Medium,Groot,Volledig" type="ComboBox" data="Auto,Small,Medium,Large,Full" defaultValue="Auto" condition="introType=='text'||introType==undefined" optional="true"/>
		<introShow type="ComboBox" label="Open automatisch" defaultValue="first" options="Elke keer dat deze pagina wordt bekeken,De eerste keer dat deze pagina wordt bekeken,Nooit" data="always,first,never" optional="true" tooltip="Geef op of de introductie automatisch wordt geopend wanneer de pagina wordt bekeken"/>
	</introGroup><customLinkGroup type="group" label="Pagina ID" optional="true" tooltip="Maak een aangepaste URL voor deze pagina" info="&lt;p&gt;Maak een directe link naar deze pagina door #jePaginaID toe te voegen aan het einde van de project-URL.&lt;br /&gt;Vermijd het gebruik van spaties, speciale tekens en het woord 'page' in ID's en zorg ervoor dat elke ID uniek is binnen het hele project.&lt;br /&gt;ID's zijn hoofdlettergevoelig.&lt;/p&gt;" common="true">
		<pageID label="Pagina ID" type="TextInput" optional="true"/>
	</customLinkGroup><unmarkForCompletion label="Voltooiing niet verplicht" type="CheckBox" defaultValue="true" tooltip="Wanneer het leerobject wordt getrackt (bijvoorbeeld met behulp van SCORM of xAPI), selecteer 'afronding niet verplicht' wanneer de pagina niet voltooid hoeft te worden, zodat het leerobject als voltooid kan worden gemarkeerd." optional="true" common="true"/><disableGlossary label="Woordenlijst uitzetten" defaultValue="true" type="CheckBox" condition="treeroot.glossary!=undefined" optional="true" tooltip="Voorkom dat woorden uit de woordenlijst op deze pagina worden getoond" common="true"/><styles label="Stijl" type="script" height="200" optional="true" tooltip="Voeg op maat gemaakte CSS toe aan deze pagina" common="true"/><tracking type="group" label="Tracking" optional="true" tooltip="Eigenschappen met betrekking tot tracked leerobjecten (bijvoorbeeld SCORM or xAPI)" common="true">
        <trackinglabel label="Trackinglabel" type="TextInput" wysiwyg="false" optional="true" tooltip="In plaats van paginanummer het label als tracking identifier gebruiken (SCORM en xAPI)"/>
        <grouping label="Track groepering" type="Grouping" optional="true" tooltip="Label voor groepering van xAPI events, om te gebruiken voor groepering in xAPI rapporten"/>
	</tracking><scripts type="group" label="Script" optional="true" tooltip="Voeg JavaScript toe die bij de eerste keer dat deze pagina geladen wordt of iedere keer dat deze pagina geladen wordt, wordt uitgevoerd " common="true">
		<script label="Script" type="script" height="200" defaultValue="// JavaScript / jQuery" optional="true"/>
		<run label="Uitvoeren" options="Alleen de eerste keer dat de pagina wordt bekeken,Iedere keer dat de pagina wordt bekeken" type="ComboBox" width="120" data="first,all" defaultValue="first" optional="true"/>
	</scripts><background type="group" label="Achtergrond" optional="true" tooltip="Voeg een achtergrondafbeelding toe aan deze pagina. Dit overschrijft elke achtergrondafbeelding die op leerobjectniveau is toegevoegd." common="true">
		<bgImage label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<backgroundFit optional="true" type="ComboBox" options="Uitrekken om te passen,Bijsnijden om te passen,Hele afbeelding tonen" data="fill,cover,contain" defaultValue="cover" label="Afbeelding schaal" tooltip="Hoe de achtergrondafbeelding de beschikbare ruimte vult. 'Uitrekken om te passen' zal de afbeelding verticaal of horizontaal uitrekken om de ruimte te vullen, 'Bijsnijden om te passen' zal de afbeelding bijsnijden om te passen zonder deze te vervormen en 'Hele afbeelding weergeven' zal de volledige geschaalde afbeelding weergeven zonder deze te vervormen. Let op: dit heeft geen effect in Internet Explorer."/>
		<bgImageAlpha label="Doorzichtigheid" type="NumericStepper" min="0" max="100" step="10" defaultValue="30" optional="true" tooltip="De dekking van de afbeelding, waarbij 0 volledig transparant is en 100 helemaal niet transparant is."/>
		<bgImageDark optional="true" type="NumericStepper" min="0" max="100" step="1" defaultValue="0" label="Donkerheid" tooltip="Voeg een filter toe om de afbeelding donkerder te maken. 0 is niet donker en 100 is volledig donker (zwart)."/>
		<bgImageGrey optional="true" type="CheckBox" label="Grijsschaal" defaultValue="false" tooltip="Voeg een filter toe om de kleur van de afbeelding te veranderen naar een grijsschaal."/>
	</background><pageTimer type="group" label="Pagina timer" optional="true" tooltip="Voeg een timer toe aan de pagina, tel terug naar 0" common="true">
		<showTimer label="Toon timer" optional="true" type="CheckBox" defaultValue="true" conditionTrigger="true"/>
		<timer label="Toon limiet (seconden)" defaultValue="60" type="NumericStepper" min="0" step="1" width="100" condition="showTimer=='true'" optional="true"/>
		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
		<lightbox type="CheckBox" label="Lightbox afbeeldingen" defaultValue="true" conditionTrigger="true" optional="true"/>
		<lightboxCaption type="ComboBox" label="Onderschrift" defaultValue="false" condition="lightbox=='true'" optional="true" options="Geen,Onder afbeelding,Boven afbeelding" data="false,below,above" tooltip="Voeg een onderschrift toe aan lightbox-afbeeldingen op deze pagina. De onderschrifttekst is afkomstig uit de velden 'Beschrijving' of 'Alt-tekst'."/>
	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></imageSequence><case menuItem="Casus" icon="icFolder" duplicate="true" remove="true">
    <name label="Titel" type="TextInput" wysiwyg="true"/>
    <txt label="Tekst" type="TextArea" height="300" placeholder="Voeg hier tekst toe"/>
	
	<caseID label="Casus ID" type="TextInput" optional="true" tooltip="Link direct naar deze casus door er een unieke ID aan te geven"/>
	
	<newNodes>
	  <imgSeries><![CDATA[<imgSeries name="Naam reeks" txt="" src="" tooltip="" firstImg="" lastImg="" cycleImages="false"/>]]></imgSeries>
	  <singleImg><![CDATA[<singleImg name="Naam afbeelding" txt="" src="" tooltip=""/>]]></singleImg>
	</newNodes>
	
  </case><imgSeries menuItem="Reeks" icon="icPictures" duplicate="true" remove="true">
    <name label="Titel" type="TextInput" wysiwyg="true"/>
    <txt label="Tekst" type="TextArea" height="300" placeholder="Voeg hier tekst toe"/>
	
	<thumbGroup type="group" label="Miniatuurafbeeldingen" tooltip="De afbeelding die in het miniatuurafbeeldingmenu verschijnt als deze casus meer dan &#xE9;&#xE9;n serie of afbeelding bevat">
		<src label="Bestand" type="media" placeholder="Selecteer afbeelding"/>
		<tooltip label="Omschrijving" type="TextInput" placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
	</thumbGroup>
	
	<imgGroup type="group" label="Afbeelding reeksen" info="&lt;p&gt;Bestandsnamen van afbeeldingen binnen de reeks moeten identiek zijn, behalve een nummer aan het einde dat de positie van de afbeelding binnen de reeks bepaalt.&lt;/p&gt;&lt;p&gt;In een reeks van 50 afbeeldingen kunnen de afbeeldingen bijvoorbeeld afb1.jpg, afb2.jpg, afb3.jpg... afb50.jpg worden genoemd.&lt;/p&gt;&lt;p&gt;Alle afbeeldingen voor de serie moeten in dezelfde map staan.&lt;/p&gt;">
		<firstImg label="Eerste afbeelding" type="media" placeholder="Selecteer afbeelding" tooltip="De eerste afbeelding in de reeks"/>
		<lastImg label="Laatste afbeelding" type="media" mandatory="true" placeholder="Selecteer afbeelding" tooltip="De laatste afbeelding in de reeks"/>
		<cycleImages label="Loop afbeeldingen" type="checkBox" defaultValue="false" tooltip="Indien aangevinkt, wordt de serie in een loop afgespeeld in plaats van te stoppen bij de laatste afbeelding"/>
	</imgGroup>
	
	<initImg label="Oorspronkelijke afbeelding" type="media" optional="true" placeholder="Selecteer afbeelding" tooltip="De eerste afbeelding die wordt getoond wanneer de serie is geladen. Standaard is dit de eerste afbeelding, maar kan met deze optionele eigenschap worden gewijzigd in elke afbeelding binnen de serie"/>
	<seriesID label="ID reeksen" type="TextInput" optional="true" tooltip="Link direct naar deze serie door er een unieke ID aan te geven"/>
	
  </imgSeries><singleImg menuItem="Enkele afbeelding" icon="icPicture" duplicate="true" remove="true">
    <name label="Titel" type="TextInput" wysiwyg="true"/>
    <txt label="Tekst" type="TextArea" height="300" placeholder="Voeg hier tekst toe"/>
	
	<thumbGroup type="group" label="Afbeelding">
		<src label="Bestand" type="media" placeholder="Selecteer afbeelding"/>
		<tooltip label="Omschrijving" type="TextInput" placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
	</thumbGroup>
	
	<seriesID label="ID afbeelding" type="TextInput" optional="true" tooltip="Link rechtstreeks naar deze afbeelding door er een unieke ID aan te geven"/>
	
  </singleImg><imageViewer menu="Media" menuItem="Afbeelding viewer" hint="Geeft de gebruiker de mogelijkheid om in en uit te zoomen op grote afbeeldingen en het selecteren van gebieden op de afbeelding. Een handige manier om grote foto's op een klein scherm te presenteren.&lt;br&gt;" icon="icImage" thumb="thumbs/imageViewer.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#afbeeldingviewer" wiki="https://xerte.org.uk/wiki/doku.php?id=media_image_viewer_page" label="Pagina tekst" placeholder="Voeg paginatekst toe" type="text" height="250" remove="true">

    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
	<align label="Tekst uitlijnen" options="Links,Rechts,Boven,Onder" type="ComboBox" data="Left,Right,Top,Bottom" defaultValue="Left" width="100"/>
	
	<image type="group" label="Afbeelding">
		<url label="Bestand" type="media" placeholder="Selecteer afbeelding"/>
		<imagesize label="Grootte" options="Klein,Medium,Groot" data="small,medium,large" mandatory="true" type="ComboBox" width="100"/>
		<tip label="Omschrijving" type="TextInput" placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
	</image>
	
    <moveTip label="Tooltip verplaats knop" type="textInput" divider="true" language="true"/>	
    <zoomInTip label="Tooltip zoom in knop" type="textInput" language="true"/>
    <zoomOutTip label="Tooltip zoom uit knop" type="textInput" language="true"/>
    <selectAreaTip label="Tooltip selecteer knop" type="textInput" language="true"/>
    <resetImageTip label="Tooltip herstelknop" type="textInput" language="true"/>
    <toggleScreenTip label="Tooltip toggle knop " type="textInput" language="true"/>

  <resources label="Bronnen bestanden / links" type="DataGrid" gridTxt="&lt;p&gt;Bronnen kunnen URL's, ge&#xFC;ploade bestanden of andere pagina's binnen deze pagina of leerobject zijn.&lt;br /&gt;Voer een URL in, upload een bestand naar het bronveld of selecteer een pagina in het dropdownmenu 'Xerte-paginalink'.&lt;/p&gt;" columns="4" colWidths="20,15,15,50" editable="1,1,1,1" cellType="textInput,media,pageList,textArea" wysiwyg="false,false,false,true" controls="1" headers="Titel,Bron,Xerte Pagina Link,Beschrijving" newRow=",,," defaultValue="|" optional="true" tooltip="Een lijst met aanvullende bronnen met betrekking tot de pagina-inhoud" common="true"/><narrate type="group" label="Audio" optional="true" tooltip="Voeg een audio player toe aan de onderkant van de pagina" common="true">
		<narration label="Audio bestand" type="media" defaultValue="Selecteer een audiobestand" placeholder="Selecteer een audio bestand" optional="true"/>
		<narrationTranscript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er wordt een transcriptknop toegevoegd aan de audiobalk wanneer transcripttekst is opgenomen"/>    
		<playNarration label="Auto-Play" type="CheckBox" defaultValue="false" optional="true" tooltip="Speel automatisch af wanneer de pagina wordt bekeken. NB.: sommige browsers staan automatisch afspelen niet toe"/>
		<narrationNavigate label="Navigeer aan het einde" type="CheckBox" defaultValue="false" optional="true" tooltip="Ga automatisch naar de volgende pagina wanneer de audio afgelopen is"/>
	</narrate><navSetting label="Navigatie knoppen" options="Alle,Vorige en volgende,Alleen terug,Alleen volgende,Geen" type="ComboBox" width="120" data="all,backnext,backonly,nextonly,none" defaultValue="all" optional="true" deprecated="Deze optie wordt niet meer gebruikt in deze XOT versie. Gebruik de nieuwe groep Navigatie knoppen (optionele eigenschap) om deze in te stellen." common="true"/><navBtns type="group" label="Navigatie knoppen" optional="true" tooltip="Schakel de individuele navigatieknoppen op deze pagina uit" info="Het standaard beschikbaar hebben van alle navigatie knoppen op iedere pagina hangt af van de navigatie instelling van het leerobject. Deactiveer knoppen op de individuele pagina's door deze te selecteren op die pagina." common="true">
		<home label="Home / Menu knop" type="CheckBox" defaultValue="true" optional="true"/>
		<back label="Terug / Vorige knop" type="CheckBox" defaultValue="true" optional="true"/>
		<next label="Volgende knop" type="CheckBox" defaultValue="true" optional="true"/>
		<save label="Sessie opslaan knop" type="CheckBox" defaultValue="true" optional="true"/>
	</navBtns><hideShow type="group" label="Verberg/Toon pagina" optional="true" tooltip="GEEF EEN BESCHRIJVING HIER..." info="Je kunt deze pagina altijd verbergen door de velden 'Van' en 'Tot' leeg te laten. Je kunt ook een datum (en eventueel een tijd) opgeven in de velden 'Van' en 'Tot' om aan te geven wanneer de pagina beschikbaar moet zijn." common="true">
		<hidePage label="Verberg pagina" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideOnTime label="Van (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideOnDate!=''&amp;&amp;hideOnDate!=undefined"/>
		<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideUntilTime label="Tot (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideUntilDate!=''&amp;&amp;hideUntilDate!=undefined"/>
	</hideShow><linkGroup type="group" label="Stand-alone pagina" optional="true" tooltip="Verwijder pagina van menu zodat je alleen via Xertelinks toegang hebt." common="true">
		<linkPage label="Stand-alone" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<linkTarget label="Open in" type="ComboBox" data="same,new,lightbox" options="Zelfde venster,Nieuw venster,Lightbox" defaultValue="lightbox" condition="linkPage=='true'" optional="true" tooltip="Geeft aan hoe de link naar deze pagina wordt geopend"/>
		<headerHide label="Verberg header" type="Checkbox" defaultValue="false" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de headerbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bijvoorbeeld bekijkt in een lightbox."/>
		<footerHide label="Verberg Voetbalk" type="CheckBox" defaultValue="true" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de voetbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bekijkt in een lightbox."/>
		<reqProgress label="Opnemen in de voortgangbalk" type="CheckBox" defaultValue="false" condition="linkPage=='true'&amp;&amp;(treeroot.progressBar!=undefined||treeroot.progressBarType=='true'||((treeroot.progressBarType=='header1'||treeroot.progressBarType=='header2'||treeroot.progressBarType=='header3')&amp;&amp;treeroot.progressSub=='false'))" optional="true" tooltip="Standaard worden stand-alone pagina's uitgesloten van het voltooiings percentage op de voortgangsbalk. Vink deze optie aan om deze pagina wel op te nemen in de voortgang van het leerobject."/>
	</linkGroup><passwordGroup type="group" label="Toegangscode" optional="true" tooltip="De toegang tot deze pagina is beperkt totdat een toegangscode wordt ingevoerd. Let op: om het leerobject veilig te beschermen, moet je de beveiliging regelen via het tabblad Toegang in de leerobject eigenschappen in plaats van deze optionele eigenschap te gebruiken. Deze functie is vooral bedoeld voor het ontsluiten van nieuw materiaal en niet voor beveiliging volgens de AVG." common="true">
		<password label="Toegangscode(s)" type="TextInput" optional="true" defaultValue="" tooltip="Een komma gescheiden lijst met toegangscodes die toegang geven tot deze site"/>
		<passwordCase label="Hoofdletter gevoelig" type="CheckBox" optional="true" defaultValue="true" tooltip="De toegangscodes zijn hoofdletter gevoelig wanneer deze optie is aangevinkt"/>
		<passwordType label="Type" type="ComboBox" data="standard,centered,vault,vaultnumeric" options="Standaard,Standaard midden,Kluis,Toetsenbord" optional="true" defaultValue="standard" tooltip="Pas het uiterlijk van de toegangscode-informatie op de pagina aan. De toegangscode moet numeriek zijn wanneer 'Toetsenbord' wordt gebruikt."/>
		<passwordInfo label="Instructies" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Enter an access code below to view the page:&lt;/p&gt;" tooltip="De instructies die verschijnen in het toegangscode venster"/>
		<passwordError label="Foutmelding" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Invalid access code&lt;/p&gt;" tooltip="De foutmelding die verschijnt wanneer de verkeerde toegangscode wordt gebruikt"/>
		<passwordSubmit label="Label knop" type="TextInput" optional="true" defaultValue="Controleer" tooltip="Het label van de vul toegangscode in knop"/>
	</passwordGroup><introGroup type="group" label="Introductie" optional="true" tooltip="Voeg een Pagina-introductie knop toe aan de voetbalk die informatie in een lightbox opent, wanneer erop wordt geklikt. Deze introductie kan worden ingesteld om automatisch te openen wanneer de pagina voor het eerst wordt geladen." common="true">
		<introType type="ComboBox" label="Content type" defaultValue="text" options="Tekst,Afbeelding,Video,URL,Bestand" data="text,image,video,url,file" conditionTrigger="true" optional="true" tooltip="Het type inhoud dat wordt gebruikt als introductie voor deze pagina"/>
		<pageIntro label="Tekst" type="TextArea" height="100" defaultValue="" condition="introType=='text'||introType==undefined" optional="true"/>
		<introImg label="Afbeelding" type="media" height="100" defaultValue="" condition="introType=='image'" optional="true" placeholder="Selecteer afbeelding"/>
		<introVideo label="Video" type="media" height="100" defaultValue="" condition="introType=='video'" optional="true" placeholder="Selecteer een videobestand of voer een url/embedcode in"/>
		<introTip label="Omschrijving" type="TextInput" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)." condition="introType=='image'||introType=='video'" optional="true"/>
		<introCaption label="Onderschrift" type="TextInput" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" condition="introType=='image'" optional="true" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
		<introURL label="URL" type="TextInput" defaultValue="" condition="introType=='url'" optional="true" placeholder="Voeg een URL toe"/>
		<introFile label="Bestand" type="media" height="100" defaultValue="" condition="introType=='file'" optional="true" placeholder="Selecteer een bestand (bijvoorbeeld een PDF)"/>
		<introTitle type="CheckBox" label="Weergeven titel" defaultValue="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Toon de paginatitel boven de introductietekst"/>
		<introBtn type="CheckBox" label="Start knop" defaultValue="true" conditionTrigger="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Voeg een 'start'-knop toe onder de introductietekst die de lightbox sluit wanneer erop wordt geklikt"/>
		<introBtnTxt label="Tekst knop" type="TextInput" defaultValue="Start" condition="introBtn=='true'&amp;&amp;(introType=='text'||introType==undefined||introType=='image')" wysiwyg="true" optional="true"/>
		<introWidth label="Breedte lightbox" options="Auto,Klein,Medium,Groot,Volledig" type="ComboBox" data="Auto,Small,Medium,Large,Full" defaultValue="Auto" condition="introType=='text'||introType==undefined" optional="true"/>
		<introShow type="ComboBox" label="Open automatisch" defaultValue="first" options="Elke keer dat deze pagina wordt bekeken,De eerste keer dat deze pagina wordt bekeken,Nooit" data="always,first,never" optional="true" tooltip="Geef op of de introductie automatisch wordt geopend wanneer de pagina wordt bekeken"/>
	</introGroup><customLinkGroup type="group" label="Pagina ID" optional="true" tooltip="Maak een aangepaste URL voor deze pagina" info="&lt;p&gt;Maak een directe link naar deze pagina door #jePaginaID toe te voegen aan het einde van de project-URL.&lt;br /&gt;Vermijd het gebruik van spaties, speciale tekens en het woord 'page' in ID's en zorg ervoor dat elke ID uniek is binnen het hele project.&lt;br /&gt;ID's zijn hoofdlettergevoelig.&lt;/p&gt;" common="true">
		<pageID label="Pagina ID" type="TextInput" optional="true"/>
	</customLinkGroup><unmarkForCompletion label="Voltooiing niet verplicht" type="CheckBox" defaultValue="true" tooltip="Wanneer het leerobject wordt getrackt (bijvoorbeeld met behulp van SCORM of xAPI), selecteer 'afronding niet verplicht' wanneer de pagina niet voltooid hoeft te worden, zodat het leerobject als voltooid kan worden gemarkeerd." optional="true" common="true"/><disableGlossary label="Woordenlijst uitzetten" defaultValue="true" type="CheckBox" condition="treeroot.glossary!=undefined" optional="true" tooltip="Voorkom dat woorden uit de woordenlijst op deze pagina worden getoond" common="true"/><styles label="Stijl" type="script" height="200" optional="true" tooltip="Voeg op maat gemaakte CSS toe aan deze pagina" common="true"/><tracking type="group" label="Tracking" optional="true" tooltip="Eigenschappen met betrekking tot tracked leerobjecten (bijvoorbeeld SCORM or xAPI)" common="true">
        <trackinglabel label="Trackinglabel" type="TextInput" wysiwyg="false" optional="true" tooltip="In plaats van paginanummer het label als tracking identifier gebruiken (SCORM en xAPI)"/>
        <grouping label="Track groepering" type="Grouping" optional="true" tooltip="Label voor groepering van xAPI events, om te gebruiken voor groepering in xAPI rapporten"/>
	</tracking><scripts type="group" label="Script" optional="true" tooltip="Voeg JavaScript toe die bij de eerste keer dat deze pagina geladen wordt of iedere keer dat deze pagina geladen wordt, wordt uitgevoerd " common="true">
		<script label="Script" type="script" height="200" defaultValue="// JavaScript / jQuery" optional="true"/>
		<run label="Uitvoeren" options="Alleen de eerste keer dat de pagina wordt bekeken,Iedere keer dat de pagina wordt bekeken" type="ComboBox" width="120" data="first,all" defaultValue="first" optional="true"/>
	</scripts><background type="group" label="Achtergrond" optional="true" tooltip="Voeg een achtergrondafbeelding toe aan deze pagina. Dit overschrijft elke achtergrondafbeelding die op leerobjectniveau is toegevoegd." common="true">
		<bgImage label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<backgroundFit optional="true" type="ComboBox" options="Uitrekken om te passen,Bijsnijden om te passen,Hele afbeelding tonen" data="fill,cover,contain" defaultValue="cover" label="Afbeelding schaal" tooltip="Hoe de achtergrondafbeelding de beschikbare ruimte vult. 'Uitrekken om te passen' zal de afbeelding verticaal of horizontaal uitrekken om de ruimte te vullen, 'Bijsnijden om te passen' zal de afbeelding bijsnijden om te passen zonder deze te vervormen en 'Hele afbeelding weergeven' zal de volledige geschaalde afbeelding weergeven zonder deze te vervormen. Let op: dit heeft geen effect in Internet Explorer."/>
		<bgImageAlpha label="Doorzichtigheid" type="NumericStepper" min="0" max="100" step="10" defaultValue="30" optional="true" tooltip="De dekking van de afbeelding, waarbij 0 volledig transparant is en 100 helemaal niet transparant is."/>
		<bgImageDark optional="true" type="NumericStepper" min="0" max="100" step="1" defaultValue="0" label="Donkerheid" tooltip="Voeg een filter toe om de afbeelding donkerder te maken. 0 is niet donker en 100 is volledig donker (zwart)."/>
		<bgImageGrey optional="true" type="CheckBox" label="Grijsschaal" defaultValue="false" tooltip="Voeg een filter toe om de kleur van de afbeelding te veranderen naar een grijsschaal."/>
	</background><pageTimer type="group" label="Pagina timer" optional="true" tooltip="Voeg een timer toe aan de pagina, tel terug naar 0" common="true">
		<showTimer label="Toon timer" optional="true" type="CheckBox" defaultValue="true" conditionTrigger="true"/>
		<timer label="Toon limiet (seconden)" defaultValue="60" type="NumericStepper" min="0" step="1" width="100" condition="showTimer=='true'" optional="true"/>
		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
		<lightbox type="CheckBox" label="Lightbox afbeeldingen" defaultValue="true" conditionTrigger="true" optional="true"/>
		<lightboxCaption type="ComboBox" label="Onderschrift" defaultValue="false" condition="lightbox=='true'" optional="true" options="Geen,Onder afbeelding,Boven afbeelding" data="false,below,above" tooltip="Voeg een onderschrift toe aan lightbox-afbeeldingen op deze pagina. De onderschrifttekst is afkomstig uit de velden 'Beschrijving' of 'Alt-tekst'."/>
	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></imageViewer><interactiveTable menu="Interactiviteit" menuItem="Interactieve tabel" hint="Een pagina voor het maken van een interactieve tabel waarin tabelcellen vragen of knoppen kunnen bevatten die aanvullende informatie weergeven." icon="icTableEdit" thumb="thumbs/interactiveTable.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#interactievetabel" wiki="https://xerte.org.uk/wiki/doku.php?id=interactivity_interactiveTable_page" remove="true" deepLink="true">

    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
    <text label="Pagina tekst" type="TextArea" height="100" placeholder="Voeg paginatekst toe"/>
    <align label="Tekst uitlijnen" options="Links,Rechts" type="ComboBox" data="Left,Right"/>
    <data label="Tabel data" newRow="data,data" newCol="data" type="DataGrid" height="190" width="390" columns="2" editable="1,1" controls="1" addCols="true" showHeaderRow="false" wysiwyg="true" tooltip="Maak een tabel met de getoonde gegevens voordat er interactieve cellen worden geactiveerd. Het juiste aantal kolommen en rijen moet in deze tabel worden gemaakt, zelfs als cellen leeg blijven totdat er interactie mee wordt uitgevoerd."/>
    <panelWidth label="Tabel breedte" options="Automatisch,Klein,Medium,Groot,Volledig" type="ComboBox" data="auto,small,medium,large,full" tooltip="Wanneer ingesteld op klein, gemiddeld of groot, wordt de geselecteerde grootte overschreven indien nodig om de inhoud van de tabel weer te geven."/>

    <caption label="Tabel titel" type="TextInput" wysiwyg="true" optional="true" tooltip="Een titel/tekst die boven de tabel verschijnt"/>

    <display type="group" label="Tabel uiterlijk" optional="true">
      <borders label="Randen" type="ComboBox" options="Geen,Volledig raster,Eenvoudig,Alleen horizontaal,Alleen verticaal,Buitenrand" data="none,full,simple,horizontal,vertical,outside" defaultValue="full" optional="true"/>
      <shade label="Shaduw afwisselende rijen" type="Checkbox" defaultValue="false" optional="true"/>
      <headFootGroup label="Header/Voetbalk" type="group" optional="true">
        <header label="Header cellen" options="Geen, Eerste rij, Eerste kolom, Eerste rij en kolom" type="ComboBox" data="none,row,col,both" defaultValue="none" conditionTrigger="true" optional="true"/>
        <footer label="Voetbalk" type="CheckBox" defaultValue="false" conditionTrigger="true" optional="true"/>
        <shadeHeader label="Shaduw Header / Voetbalk" type="Checkbox" defaultValue="false" condition="header!='none'||footer!='false'" optional="true"/>
      </headFootGroup>
    </display>

    <iconGroup label="Iconen" type="group" optional="true" tooltip="Pas de klikbare pictogrammen aan die in interactieve cellen worden getoond.">
      <qIcons label="Vraag" type="group" optional="group">
        <qIconLabel label="Tooltip" type="TextInput" defaultValue="Vraag" optional="true" tooltip="De tooltip-beschrijving voor de vraagiconen"/>
        <qCustomIcon label="Aanpassen icoon" type="CheckBox" defaultValue="false" optional="true" conditionTrigger="true" tooltip="Vervang het standaardicoon dat aangeeft dat deze cel interactief is. Als je dit aanzet, kun je een ander icoon kiezen."/>
        <qIcon label="Icoon" type="FontAwesome" iconList="hotspot" defaultValue="fas fa-question" optional="true" condition="qCustomIcon=='true'"/>
      </qIcons>
      <infoIcons label="Informatie" type="group" optional="group">
        <infoIconLabel label="Tooltip (cel)" type="TextInput" defaultValue="Toon informatie" optional="true" tooltip="De tooltip-beschrijving voor de informatieknoppen als ze extra info in de tabelcellen laten zien."/>
        <infoIconLabel2 label="Tooltip (lightbox)" type="TextInput" defaultValue="Leer mee" optional="true" tooltip="De tooltip-beschrijving voor de informatieknoppen als ze extra info in lightboxes laten zien."/>
        <infoIconTick label="Vink af indien bekeken" type="CheckBox" defaultValue="true" optional="true" tooltip="Standaard verandert het icoon op de knop in een vinkje nadat de informatie in een lightbox is bekeken."/>
        <infoCustomIcon label="Aanpassen icoon" type="CheckBox" defaultValue="false" optional="true" conditionTrigger="true" tooltip="Vervang het standaardicoon dat aangeeft dat deze cel interactief is. Als je dit aanzet, kun je een ander icoon kiezen."/>
        <infoIcon label="Icoon" type="FontAwesome" iconList="hotspot" defaultValue="fas fa-info" optional="true" condition="infoCustomIcon=='true'"/>
      </infoIcons>
    </iconGroup>

    <reveal label="Onthul interactieve cellen" type="ComboBox" options="Alles tegelijk, &#xC9;&#xE9;n voor &#xE9;&#xE9;n, &#xE9;&#xE9;n rij tegelijk, &#xE9;&#xE9;n kolom tegelijk" data="all,one,row,col" defaultValue="all" conditionTrigger="true" optional="true"/>
    <attempts label="Aantal pogingen" defaultValue="2" type="NumericStepper" min="0" max="10" step="1" optional="true" tooltip="Het aantal pogingen dat voor elke vraag toegestaan &#x200B;is &#x200B;voordat het juiste antwoord wordt weergegeven. Wanneer pogingen op nul is ingesteld, is een onbeperkt aantal pogingen toegestaan &#x200B;&#x200B;en wordt het juiste antwoord nooit weergegeven wanneer er een onjuist antwoord is ingediend."/>
    <feedback label="Feedback" type="TextArea" height="40" optional="true" tooltip="Feedback wordt getoond nadat alle cellen interactie hebben gehad met "/>

    <delimiters type="group" label="Scheidingstekens" optional="true">
      <answerDelimiter label="Juiste antwoord" type="textInput" defaultValue="," optional="true" tooltip="Het teken dat de mogelijke juiste antwoorden voor elke vraag scheidt."/>
      <dropDownDelimiter label="Drop-down menu optie" type="textInput" defaultValue="/" optional="true" tooltip="Het teken dat de opties scheidt die in een drop-down menu verschijnen, bijvoorbeeld Engeland/Schotland/Wales, waarbij het eerste antwoord in de lijst het juiste antwoord is."/>
    </delimiters>

    <trackingWeight label="Tracking score weging" optional="true" type="textInput" defaultValue="1.0" tooltip="Pas de weging van de opdracht op deze pagina aan, ten opzichte van andere gescoorde pagina's in het leerobject. Als je de weging instelt op 0, betekent dit dat de opdracht op deze pagina niet meetelt de totaalscore van het leerobject."/>

    <submitLabel label="Label controleer" type="TextInput" wysiwyg="true" divider="true" language="true"/>
    <continueLabel label="Label ga door" type="TextInput" wysiwyg="true" language="true"/>
    <correctTxt label="Juiste antwoord" type="TextInput" wysiwyg="true" language="true"/>
    <incorrectTxt label="Onjuist antwoord" type="TextInput" wysiwyg="true" language="true"/>
    <correctFbTxt label="Feedback juiste antwoord" type="TextInput" wysiwyg="true" language="true"/>
    <incomplete label="Tekst niet compleet" type="TextInput" wysiwyg="true" language="true" mandatory="true" defaultValue="Maak de oefening af"/>
    <srCorrectTxt label="Onjuist antwoord (alleen screenreaders)" type="TextInput" language="true"/>
    <srIncorrectTxt label="Juist antwoord (alleen screenreaders)" type="TextInput" language="true"/>

    <newNodes>
      <tableCell><![CDATA[<tableCell name="Cel" fieldPos="" cellType="question" text="" showIn="cell" replace="end" required="false" answer="" type="text" qShowIn="cell" qText="" qAfter="true" qAfterInfo="submitted"/>]]></tableCell>
    </newNodes>
	
  <resources label="Bronnen bestanden / links" type="DataGrid" gridTxt="&lt;p&gt;Bronnen kunnen URL's, ge&#xFC;ploade bestanden of andere pagina's binnen deze pagina of leerobject zijn.&lt;br /&gt;Voer een URL in, upload een bestand naar het bronveld of selecteer een pagina in het dropdownmenu 'Xerte-paginalink'.&lt;/p&gt;" columns="4" colWidths="20,15,15,50" editable="1,1,1,1" cellType="textInput,media,pageList,textArea" wysiwyg="false,false,false,true" controls="1" headers="Titel,Bron,Xerte Pagina Link,Beschrijving" newRow=",,," defaultValue="|" optional="true" tooltip="Een lijst met aanvullende bronnen met betrekking tot de pagina-inhoud" common="true"/><narrate type="group" label="Audio" optional="true" tooltip="Voeg een audio player toe aan de onderkant van de pagina" common="true">
		<narration label="Audio bestand" type="media" defaultValue="Selecteer een audiobestand" placeholder="Selecteer een audio bestand" optional="true"/>
		<narrationTranscript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er wordt een transcriptknop toegevoegd aan de audiobalk wanneer transcripttekst is opgenomen"/>    
		<playNarration label="Auto-Play" type="CheckBox" defaultValue="false" optional="true" tooltip="Speel automatisch af wanneer de pagina wordt bekeken. NB.: sommige browsers staan automatisch afspelen niet toe"/>
		<narrationNavigate label="Navigeer aan het einde" type="CheckBox" defaultValue="false" optional="true" tooltip="Ga automatisch naar de volgende pagina wanneer de audio afgelopen is"/>
	</narrate><navSetting label="Navigatie knoppen" options="Alle,Vorige en volgende,Alleen terug,Alleen volgende,Geen" type="ComboBox" width="120" data="all,backnext,backonly,nextonly,none" defaultValue="all" optional="true" deprecated="Deze optie wordt niet meer gebruikt in deze XOT versie. Gebruik de nieuwe groep Navigatie knoppen (optionele eigenschap) om deze in te stellen." common="true"/><navBtns type="group" label="Navigatie knoppen" optional="true" tooltip="Schakel de individuele navigatieknoppen op deze pagina uit" info="Het standaard beschikbaar hebben van alle navigatie knoppen op iedere pagina hangt af van de navigatie instelling van het leerobject. Deactiveer knoppen op de individuele pagina's door deze te selecteren op die pagina." common="true">
		<home label="Home / Menu knop" type="CheckBox" defaultValue="true" optional="true"/>
		<back label="Terug / Vorige knop" type="CheckBox" defaultValue="true" optional="true"/>
		<next label="Volgende knop" type="CheckBox" defaultValue="true" optional="true"/>
		<save label="Sessie opslaan knop" type="CheckBox" defaultValue="true" optional="true"/>
	</navBtns><hideShow type="group" label="Verberg/Toon pagina" optional="true" tooltip="GEEF EEN BESCHRIJVING HIER..." info="Je kunt deze pagina altijd verbergen door de velden 'Van' en 'Tot' leeg te laten. Je kunt ook een datum (en eventueel een tijd) opgeven in de velden 'Van' en 'Tot' om aan te geven wanneer de pagina beschikbaar moet zijn." common="true">
		<hidePage label="Verberg pagina" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideOnTime label="Van (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideOnDate!=''&amp;&amp;hideOnDate!=undefined"/>
		<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideUntilTime label="Tot (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideUntilDate!=''&amp;&amp;hideUntilDate!=undefined"/>
	</hideShow><linkGroup type="group" label="Stand-alone pagina" optional="true" tooltip="Verwijder pagina van menu zodat je alleen via Xertelinks toegang hebt." common="true">
		<linkPage label="Stand-alone" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<linkTarget label="Open in" type="ComboBox" data="same,new,lightbox" options="Zelfde venster,Nieuw venster,Lightbox" defaultValue="lightbox" condition="linkPage=='true'" optional="true" tooltip="Geeft aan hoe de link naar deze pagina wordt geopend"/>
		<headerHide label="Verberg header" type="Checkbox" defaultValue="false" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de headerbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bijvoorbeeld bekijkt in een lightbox."/>
		<footerHide label="Verberg Voetbalk" type="CheckBox" defaultValue="true" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de voetbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bekijkt in een lightbox."/>
		<reqProgress label="Opnemen in de voortgangbalk" type="CheckBox" defaultValue="false" condition="linkPage=='true'&amp;&amp;(treeroot.progressBar!=undefined||treeroot.progressBarType=='true'||((treeroot.progressBarType=='header1'||treeroot.progressBarType=='header2'||treeroot.progressBarType=='header3')&amp;&amp;treeroot.progressSub=='false'))" optional="true" tooltip="Standaard worden stand-alone pagina's uitgesloten van het voltooiings percentage op de voortgangsbalk. Vink deze optie aan om deze pagina wel op te nemen in de voortgang van het leerobject."/>
	</linkGroup><passwordGroup type="group" label="Toegangscode" optional="true" tooltip="De toegang tot deze pagina is beperkt totdat een toegangscode wordt ingevoerd. Let op: om het leerobject veilig te beschermen, moet je de beveiliging regelen via het tabblad Toegang in de leerobject eigenschappen in plaats van deze optionele eigenschap te gebruiken. Deze functie is vooral bedoeld voor het ontsluiten van nieuw materiaal en niet voor beveiliging volgens de AVG." common="true">
		<password label="Toegangscode(s)" type="TextInput" optional="true" defaultValue="" tooltip="Een komma gescheiden lijst met toegangscodes die toegang geven tot deze site"/>
		<passwordCase label="Hoofdletter gevoelig" type="CheckBox" optional="true" defaultValue="true" tooltip="De toegangscodes zijn hoofdletter gevoelig wanneer deze optie is aangevinkt"/>
		<passwordType label="Type" type="ComboBox" data="standard,centered,vault,vaultnumeric" options="Standaard,Standaard midden,Kluis,Toetsenbord" optional="true" defaultValue="standard" tooltip="Pas het uiterlijk van de toegangscode-informatie op de pagina aan. De toegangscode moet numeriek zijn wanneer 'Toetsenbord' wordt gebruikt."/>
		<passwordInfo label="Instructies" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Enter an access code below to view the page:&lt;/p&gt;" tooltip="De instructies die verschijnen in het toegangscode venster"/>
		<passwordError label="Foutmelding" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Invalid access code&lt;/p&gt;" tooltip="De foutmelding die verschijnt wanneer de verkeerde toegangscode wordt gebruikt"/>
		<passwordSubmit label="Label knop" type="TextInput" optional="true" defaultValue="Controleer" tooltip="Het label van de vul toegangscode in knop"/>
	</passwordGroup><introGroup type="group" label="Introductie" optional="true" tooltip="Voeg een Pagina-introductie knop toe aan de voetbalk die informatie in een lightbox opent, wanneer erop wordt geklikt. Deze introductie kan worden ingesteld om automatisch te openen wanneer de pagina voor het eerst wordt geladen." common="true">
		<introType type="ComboBox" label="Content type" defaultValue="text" options="Tekst,Afbeelding,Video,URL,Bestand" data="text,image,video,url,file" conditionTrigger="true" optional="true" tooltip="Het type inhoud dat wordt gebruikt als introductie voor deze pagina"/>
		<pageIntro label="Tekst" type="TextArea" height="100" defaultValue="" condition="introType=='text'||introType==undefined" optional="true"/>
		<introImg label="Afbeelding" type="media" height="100" defaultValue="" condition="introType=='image'" optional="true" placeholder="Selecteer afbeelding"/>
		<introVideo label="Video" type="media" height="100" defaultValue="" condition="introType=='video'" optional="true" placeholder="Selecteer een videobestand of voer een url/embedcode in"/>
		<introTip label="Omschrijving" type="TextInput" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)." condition="introType=='image'||introType=='video'" optional="true"/>
		<introCaption label="Onderschrift" type="TextInput" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" condition="introType=='image'" optional="true" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
		<introURL label="URL" type="TextInput" defaultValue="" condition="introType=='url'" optional="true" placeholder="Voeg een URL toe"/>
		<introFile label="Bestand" type="media" height="100" defaultValue="" condition="introType=='file'" optional="true" placeholder="Selecteer een bestand (bijvoorbeeld een PDF)"/>
		<introTitle type="CheckBox" label="Weergeven titel" defaultValue="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Toon de paginatitel boven de introductietekst"/>
		<introBtn type="CheckBox" label="Start knop" defaultValue="true" conditionTrigger="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Voeg een 'start'-knop toe onder de introductietekst die de lightbox sluit wanneer erop wordt geklikt"/>
		<introBtnTxt label="Tekst knop" type="TextInput" defaultValue="Start" condition="introBtn=='true'&amp;&amp;(introType=='text'||introType==undefined||introType=='image')" wysiwyg="true" optional="true"/>
		<introWidth label="Breedte lightbox" options="Auto,Klein,Medium,Groot,Volledig" type="ComboBox" data="Auto,Small,Medium,Large,Full" defaultValue="Auto" condition="introType=='text'||introType==undefined" optional="true"/>
		<introShow type="ComboBox" label="Open automatisch" defaultValue="first" options="Elke keer dat deze pagina wordt bekeken,De eerste keer dat deze pagina wordt bekeken,Nooit" data="always,first,never" optional="true" tooltip="Geef op of de introductie automatisch wordt geopend wanneer de pagina wordt bekeken"/>
	</introGroup><customLinkGroup type="group" label="Pagina ID" optional="true" tooltip="Maak een aangepaste URL voor deze pagina" info="&lt;p&gt;Maak een directe link naar deze pagina door #jePaginaID toe te voegen aan het einde van de project-URL.&lt;br /&gt;Vermijd het gebruik van spaties, speciale tekens en het woord 'page' in ID's en zorg ervoor dat elke ID uniek is binnen het hele project.&lt;br /&gt;ID's zijn hoofdlettergevoelig.&lt;/p&gt;" common="true">
		<pageID label="Pagina ID" type="TextInput" optional="true"/>
	</customLinkGroup><unmarkForCompletion label="Voltooiing niet verplicht" type="CheckBox" defaultValue="true" tooltip="Wanneer het leerobject wordt getrackt (bijvoorbeeld met behulp van SCORM of xAPI), selecteer 'afronding niet verplicht' wanneer de pagina niet voltooid hoeft te worden, zodat het leerobject als voltooid kan worden gemarkeerd." optional="true" common="true"/><disableGlossary label="Woordenlijst uitzetten" defaultValue="true" type="CheckBox" condition="treeroot.glossary!=undefined" optional="true" tooltip="Voorkom dat woorden uit de woordenlijst op deze pagina worden getoond" common="true"/><styles label="Stijl" type="script" height="200" optional="true" tooltip="Voeg op maat gemaakte CSS toe aan deze pagina" common="true"/><tracking type="group" label="Tracking" optional="true" tooltip="Eigenschappen met betrekking tot tracked leerobjecten (bijvoorbeeld SCORM or xAPI)" common="true">
        <trackinglabel label="Trackinglabel" type="TextInput" wysiwyg="false" optional="true" tooltip="In plaats van paginanummer het label als tracking identifier gebruiken (SCORM en xAPI)"/>
        <grouping label="Track groepering" type="Grouping" optional="true" tooltip="Label voor groepering van xAPI events, om te gebruiken voor groepering in xAPI rapporten"/>
	</tracking><scripts type="group" label="Script" optional="true" tooltip="Voeg JavaScript toe die bij de eerste keer dat deze pagina geladen wordt of iedere keer dat deze pagina geladen wordt, wordt uitgevoerd " common="true">
		<script label="Script" type="script" height="200" defaultValue="// JavaScript / jQuery" optional="true"/>
		<run label="Uitvoeren" options="Alleen de eerste keer dat de pagina wordt bekeken,Iedere keer dat de pagina wordt bekeken" type="ComboBox" width="120" data="first,all" defaultValue="first" optional="true"/>
	</scripts><background type="group" label="Achtergrond" optional="true" tooltip="Voeg een achtergrondafbeelding toe aan deze pagina. Dit overschrijft elke achtergrondafbeelding die op leerobjectniveau is toegevoegd." common="true">
		<bgImage label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<backgroundFit optional="true" type="ComboBox" options="Uitrekken om te passen,Bijsnijden om te passen,Hele afbeelding tonen" data="fill,cover,contain" defaultValue="cover" label="Afbeelding schaal" tooltip="Hoe de achtergrondafbeelding de beschikbare ruimte vult. 'Uitrekken om te passen' zal de afbeelding verticaal of horizontaal uitrekken om de ruimte te vullen, 'Bijsnijden om te passen' zal de afbeelding bijsnijden om te passen zonder deze te vervormen en 'Hele afbeelding weergeven' zal de volledige geschaalde afbeelding weergeven zonder deze te vervormen. Let op: dit heeft geen effect in Internet Explorer."/>
		<bgImageAlpha label="Doorzichtigheid" type="NumericStepper" min="0" max="100" step="10" defaultValue="30" optional="true" tooltip="De dekking van de afbeelding, waarbij 0 volledig transparant is en 100 helemaal niet transparant is."/>
		<bgImageDark optional="true" type="NumericStepper" min="0" max="100" step="1" defaultValue="0" label="Donkerheid" tooltip="Voeg een filter toe om de afbeelding donkerder te maken. 0 is niet donker en 100 is volledig donker (zwart)."/>
		<bgImageGrey optional="true" type="CheckBox" label="Grijsschaal" defaultValue="false" tooltip="Voeg een filter toe om de kleur van de afbeelding te veranderen naar een grijsschaal."/>
	</background><pageTimer type="group" label="Pagina timer" optional="true" tooltip="Voeg een timer toe aan de pagina, tel terug naar 0" common="true">
		<showTimer label="Toon timer" optional="true" type="CheckBox" defaultValue="true" conditionTrigger="true"/>
		<timer label="Toon limiet (seconden)" defaultValue="60" type="NumericStepper" min="0" step="1" width="100" condition="showTimer=='true'" optional="true"/>
		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
		<lightbox type="CheckBox" label="Lightbox afbeeldingen" defaultValue="true" conditionTrigger="true" optional="true"/>
		<lightboxCaption type="ComboBox" label="Onderschrift" defaultValue="false" condition="lightbox=='true'" optional="true" options="Geen,Onder afbeelding,Boven afbeelding" data="false,below,above" tooltip="Voeg een onderschrift toe aan lightbox-afbeeldingen op deze pagina. De onderschrifttekst is afkomstig uit de velden 'Beschrijving' of 'Alt-tekst'."/>
	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></interactiveTable><tableCell menuItem="Interactieve cel" icon="icBullet" remove="true">

    <name label="Titel" type="TextInput" tooltip="Wanneer deze interactieve cel een vraag bevat, wordt de titel gebruikt om dit antwoord te identificeren op de resultatenpagina en bij het volgen van resultaten, bijvoorbeeld via SCORM/LTI/xAPI."/>
    <fieldPos label="Positie" type="TextInput" tooltip="De positie van deze interactieve cel binnen de tabel, met behulp van de indeling: kolom,rij, bijvoorbeeld 1,1"/>
    <cellType label="Interactiviteit" type="ComboBox" options="Vraag,Informatie" data="question,info" defaultValue="" conditionTrigger="true"/>

    <information label="Informatie" type="group" tooltip="Aanvullende informatie weergeven wanneer de tabelcel is geselecteerd." condition="cellType=='info'">
      <text label="Tekst" type="TextArea" height="50" defaultValue="" placeholder="Voeg hier tekst toe" condition="cellType=='info'"/>
      <showIn label="Toon in" type="ComboBox" options="Cel,Lightbox" data="cell,lightbox" defaultValue="cell" conditionTrigger="true" condition="cellType=='info'" tooltip="Bepaalt waar de informatie wordt weergegeven wanneer de cel is geselecteerd."/>
      <replace label="Voeg tekst toe" type="ComboBox" options="Aan het einde,Vervang celinhoud" data="end,replace" defaultValue="end" condition="cellType=='info'&amp;&amp;showIn=='cell'"/>
      <required label="Verplicht" type="CheckBox" defaultValue="false" condition="cellType=='info'" tooltip="Vraag of deze informatie bekeken moet worden voordat je doorgaat naar de volgende fase en/of feedback ontvangt."/>
    </information>

    <question label="Vraag" type="group" tooltip="Een tekstveld of drop-down menu weergeven in de tabelcel." condition="cellType=='question'">
      <type label="Type" options="Tekstveld,Drop-down menu" type="ComboBox" data="text,menu" defaultValue="text" condition="cellType=='question'" tooltip="Wanneer je het drop-down menu instelt, gebruik je schuine strepen om de antwoordopties te scheiden, bijvoorbeeld Engeland/Schotland/Wales, waarbij de eerste optie het juiste antwoord is"/>
      <answer label="Antwoord" type="TextInput" defaultValue="" placeholder="Voeg hier een antwoord toe" condition="cellType=='question'" tooltip="Als er meer dan &#xE9;&#xE9;n mogelijke juiste antwoorden zijn, vermeld dan elk antwoord gescheiden door een komma."/>
      <qShowIn label="Toon in" type="ComboBox" options="Cel,Lightbox" data="cell,lightbox" defaultValue="cell" conditionTrigger="true" condition="cellType=='question'" tooltip="Bepaalt waar de vraag wordt weergegeven."/>
      <qText label="Tekst" type="TextArea" height="50" defaultValue="" placeholder="Voeg hier tekst toe" condition="cellType=='question'&amp;&amp;qShowIn=='lightbox'"/>"
    </question>

    <feedback label="Feedback" type="TextArea" height="50" defaultValue="" optional="true" condition="cellType=='question'&amp;&amp;qShowIn=='lightbox'"/>

  </tableCell><interactiveText menu="Interactiviteit" menuItem="Interactieve tekst" hint="Een op tekst gebaseerde pagina waar secties ontdekt kunnen worden met diverse interactiviteiten." icon="icInteractiveTxt" thumb="thumbs/interactiveText.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#interactievetekst" wiki="https://xerte.org.uk/wiki/doku.php?id=interactivity_interactive_text_page" remove="true">
    <name label="Naam" type="TextInput" wysiwyg="true"/>
    <text label="Pagina tekst" type="TextArea" height="150" placeholder="Voeg paginatekst toe"/>
	<passage label="Interactieve tekst" type="TextArea" height="200" placeholder="Voer hier interactieve tekst in. Koppel delen van de tekst aan een groep door de unieke scheidingstekens van de groep aan beide kanten toe te voegen, bijvoorbeeld *tekst gekoppeld aan groep &#xE9;&#xE9;n*"/>
    <interactivity label="Interactiviteit" options="Onderzoek,Toon (naam),Toon (volgorde),Zoek,Zoek (beoordeel na invullen),MCQ" type="ComboBox" data="explore,show,show2,find,find2,mcq" conditionTrigger="true"/>
    <findShowNum label="Beperk aantal selecties" type="CheckBox" defaultValue="true" mandatory="true" condition="interactivity=='find2'" tooltip="&lt;p&gt;Wanneer dit is aangevinkt, moet voor elke groep het juiste aantal selecties worden gemaakt voordat de antwoorden kunnen worden gecontroleerd&lt;/p&gt;&lt;p&gt; &lt;/p&gt;"/>
	<highlight label="Onderstreep tekst" type="CheckBox"/>
	<panelWidth label="Paneelbreedte" options="Klein,Medium,Groot,Volledig" type="ComboBox" data="small,medium,large,full"/>
	<trackingWeight label="Tracking score weging" optional="true" type="textInput" width="120" defaultValue="1.0" condition="interactivity=='find2'||interactivity=='mcq'" tooltip="Pas de weging van de opdracht op deze pagina aan, ten opzichte van andere gescoorde pagina's in het leerobject. Als je de weging instelt op 0, betekent dit dat de opdracht op deze pagina niet meetelt de totaalscore van het leerobject."/>

    <findOptions type="group" label="Afleiders" optional="true" condition="interactivity=='find'||interactivity=='find2'">
        <findAllowSelectionOfAllWords label="Automatische afleiders (alleen woorden)" condition="interactivity=='find'||interactivity=='find2'" tooltip="Maakt het mogelijk om uit alle woorden te kiezen, niet alleen de vooraf geselecteerde" type="CheckBox" defaultValue="false" optional="true"/>
        <findUseDistractors label="Aangepaste afleiders (1 of meer woorden)" type="CheckBox" defaultValue="false" optional="true" conditionTrigger="true" condition="interactivity=='find'||interactivity=='find2'" tooltip="Mogelijk om afleiders te markeren door hier een scheidingteken toe te voegen."/>
        <findDistractorDelimiter label="Scheidingsteken afleider" type="TextInput" optional="true" defaultValue="Het scheidingsteken dat gebruikt wordt om een categorie in de Interactieve tekst aan te geven, bijv. *" condition="(interactivity=='find'||interactivity=='find2')&amp;&amp;findUseDistractors=='true'" tooltip="Het scheidingsteken dat gebruikt wordt om een categorie in Interactieve tekst aan te geven, bijv. *. Dit scheidingsteken kan alleen maar gebruikt worden als 'Gebruik afleiders' is aangezet."/>
    </findOptions>
	<mcqOptions type="group" label="MCQ opties" optional="true" condition="interactivity=='mcq'">
		<mcqType label="Vraagtype" options="Markeer &#xE9;&#xE9;n van de groep,Markeer de hele groep" type="ComboBox" data="one,all" defaultValue="one" condition="interactivity=='mcq'" optional="true"/>
		<mcqFB label="Feedback" type="TextArea" height="150" placeholder="Voeg hier feedback tekst toe" condition="interactivity=='mcq'" optional="true"/>
		<mcqNumQs label="Aantal vragen (*=alle)" type="TextInput" defaultValue="*" condition="interactivity=='mcq'" optional="true"/>
		<mcqNumAs label="Aantal antwoorden (*=alle)" type="TextInput" defaultValue="*" condition="interactivity=='mcq'" optional="true"/>
		<mcqMoreInfo label="Link meer informatie" tooltip="Voeg een 'meer informatie'-icoonlink toe naast de feedback om de groepsbeschrijving te tonen." type="CheckBox" defaultValue="true" mandatory="true" condition="interactivity=='mcq'" optional="true"/>
	</mcqOptions>

	<exploreTxt label="Bekijk instructie" type="TextInput" wysiwyg="true" language="true"/>
	<showMeTxt2 label="Toon de instructies." type="TextInput" wysiwyg="true" language="true"/>
	<showMeTxt label="Toon (knop) instructies" type="TextInput" wysiwyg="true" language="true"/>
	<showBtnTxt label="Label toonknop" type="TextInput" wysiwyg="true" language="true"/>
	<nextTxt label="Label volgende knop" type="TextInput" wysiwyg="true" language="true"/>
	<prevTxt label="Label vorige knop" type="TextInput" wysiwyg="true" language="true"/>
	<findTxt label="Zoek instructies" type="TextInput" wysiwyg="true" language="true"/>
	<findTxt3 label="Zoek instructies: Enkele groep" type="TextInput" wysiwyg="true" language="true"/>
	<findFeedback label="Zoek feedback" type="TextInput" wysiwyg="true" language="true"/>
	<find2Feedback label="Zoek (Beoordeel na invullen) feedback" type="TextInput" wysiwyg="true" language="true"/>
    <findTxt2 label="Je hebt {i} van de {n} gevonden" type="TextInput" wysiwyg="true" language="true"/>
    <findTxt22 label="Je hebt {i} van de {n} geselecteerd" type="TextInput" wysiwyg="true" language="true"/>
	<findCheckTxt label="Zoek Check" type="TextInput" wysiwyg="true" language="true"/>
	<mcqText label="MCQ Instructies" type="TextInput" wysiwyg="true" language="true"/>
	<mcqQuesCount label="Vraag {i} van {n}" type="TextInput" wysiwyg="true" language="true"/>
	<mcqCorrect label="MCQ juist" type="TextInput" wysiwyg="true" language="true"/>
	<mcqWrong label="MCQ onjuist" type="TextInput" wysiwyg="true" language="true"/>
