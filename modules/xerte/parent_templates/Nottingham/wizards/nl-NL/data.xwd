	<appearance type="group" label="Tabel uiterlijk">
		<size label="Grootte" options="Klein,Medium,Groot,Volledig" type="ComboBox" data="small,medium,large,full screen" defaultValue="medium" width="120"/>
		<borders label="Randen" options="Geen,Volledig grid,Eenvoudig,Alleen horizontaal,Alleen vertical,Buitenrand" type="ComboBox" data="none,full,simple,horizontal,vertical,outside" defaultValue="simple" width="120"/>
		<header label="Header/Voetbalk rijen" options="Geen,Header,Voetbalk,Beide" type="ComboBox" data="none,header,footer,both" defaultValue="header" width="120"/>
		<shadeHeader label="Schaduw Header/Voetbalk" type="Checkbox" defaultValue="true"/>
		<shade label="Schaduw alternatieve rijen" type="Checkbox" defaultValue="true"/>
	</appearance>

    <caption label="Voetnoot" type="TextInput" wysiwyg="true" optional="true" tooltip="Voeg een voetnote toe onder de tabel"/>
    <alt label="Overzicht" type="TextInput" wysiwyg="false" defaultValue="Voeg een samenvatting van de tabel toe als toegankelijkheidsinfo" placeholder="Voeg een samenvatting toe voor toegankelijkheid (accessibility)" optional="true" tooltip="Een samenvatting van de inhoud van de tabel die door screen readers wordt gelezen. Voeg dit toe om de toegankelijkheid van de pagina te verbeteren"/>
	
	<csv type="group" label="CSV" optional="true" tooltip="Upload een CSV-bestand met tabelgegevens. Dit overschrijft alle tabelgegevens die rechtstreeks via de editor zijn ingevoerd">
