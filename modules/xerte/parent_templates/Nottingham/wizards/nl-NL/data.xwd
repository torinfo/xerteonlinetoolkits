	<showfeedback label="Toon feedback" type="CheckBox" defaultValue="true"/>
    <feedback label="Feedback" type="textArea" height="120" placeholder="Voeg feedback toe" tooltip="De feedback die verschijnt nadat alle vragen in de quiz zijn beantwoord."/>
	<trackingWeight label="Tracking score weging" optional="true" type="textInput" width="120" defaultValue="1.0" tooltip="Pas de weging van de opdracht op deze pagina aan, ten opzichte van andere gescoorde pagina's in het leerobject. Als je de weging instelt op 0, betekent dit dat de opdracht op deze pagina niet meetelt de totaalscore van het leerobject."/>
	<scorePos label="Score positie" options="Boven feedback,Onder feedback" type="ComboBox" data="Above,Below" defaultValue="Below" width="120" optional="true"/>
	
    <quesCount label="{i} van {n} vragen" type="TextInput" wysiwyg="true" divider="true" language="true"/>
    <feedbackLabel label="Label feedback" type="TextInput" wysiwyg="true" language="true"/>
    <generalFeedbackLabel label="Label algemene feedback" type="TextInput" wysiwyg="true" language="true"/>
    <singleRight label="Enkel antwoord correct" type="TextInput" wysiwyg="true" language="true"/>
	<singleWrong label="Enkel antwoord onjuist" type="TextInput" wysiwyg="true" language="true"/>
    <multiRight label="Meerdere antwoorden correct" type="TextInput" wysiwyg="true" language="true"/>
    <multiWrong label="Meerder antwoorden onjuist" type="TextInput" wysiwyg="true" language="true"/>
    <onCompletion label="Tekst voltooiing" type="TextInput" wysiwyg="true" language="true"/>
    <score label="De score is {i} van de {n} punten" type="TextInput" wysiwyg="true" language="true"/>
