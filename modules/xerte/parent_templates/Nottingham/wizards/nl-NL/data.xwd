	</image>

	<hsAppearance type="group" label="Hotspot opties markering" optional="true" tooltip="Kleur hotspots instellen">
        <hsStroke type="group" label="Rand" optional="true" tooltip="Opties met betrekking tot de lijn rond de hotspotgrenzen.">
            <hicol label="Kleur" type="ColourPicker" optional="true" defaultValue="0xFFFF00" tooltip="De kleur van de rand"/>
            <hs_strokeOpacity label="Doorzichtigheid" type="TextInput" optional="true" defaultValue="1" tooltip="De doorzichtigheid (een decimaal tussen 0 en 1) van de rand"/>
            <hs_strokeWidth label="Breedte" type="TextInput" optional="true" defaultValue="1" tooltip="De breedte van de rand"/>
        </hsStroke>
        <hsFill type="group" label="Vul" optional="true" tooltip="Opties met betrekking tot de achtergrond van de hotspots.">
            <hs_fill label="Vul hotspot" type="CheckBox" optional="true" defaultValue="true" conditionTrigger="true" tooltip="Vul de hotspot met een achtergrondkleur als deze is geselecteerd."/>
            <hs_fillColor label="Kleur" type="ColourPicker" optional="true" defaultValue="0xFFFF00" condition="hs_fill=='true'" tooltip="De kleur van de hotspot achtergrond"/>
            <hs_fillOpacity label="Doorzichtigheid" type="TextInput" optional="true" defaultValue="1" condition="hs_fill=='true'" tooltip="De doorzichtigheid (een decimaal tussen 0 en 1) van de hotspot achtergrond"/>
        </hsFill>
        <hs_showTooltip label="Toon tooltip" type="CheckBox" optional="true" defaultValue="true" tooltip="Toon tooltip bij muisover, het label wordt gebruikt als tooltip"/>
    </hsAppearance>

	<interactivity label="Interactiviteit" options="Toon,Klik om te onderzoeken" type="ComboBox" data="Show Me,Click Explore" defaultValue="Show Me" tooltip="Voeg vooruit- en terugknoppen toe om de hotspots in volgorde te markeren (Toon) of hotspots moeten worden gevonden door de afbeelding zelf te verkennen (Klik om te onderzoeken)" width="100"/>
	
    <nextTxt label="Label volgende pijl" type="TextInput" wysiwyg="true" divider="true" language="true"/>
	<priorTxt label="Label vorige pijl" type="TextInput" wysiwyg="true" language="true"/>

    <newNodes>
