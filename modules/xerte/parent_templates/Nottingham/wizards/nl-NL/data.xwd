		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></links><link menuItem="Link" icon="icTagGreen" remove="true">
    <name label="Titel link" type="TextInput" wysiwyg="true"/>
