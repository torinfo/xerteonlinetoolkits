  </matchItem><modelAnswer menu="Interactiviteit" menuItem="Model antwoord" hint="Interactie via invullen van tekst, met feedback en de mogelijkheid om reacties te kopi&#xEB;ren of te downloaden." icon="icPageWhiteEdit" thumb="thumbs/modelAnswer.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#modelantwoord" wiki="https://xerte.org.uk/wiki/doku.php?id=interactivity_model_answer_page" remove="true">

    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
    <text label="Pagina tekst" type="TextArea" height="100" placeholder="Voeg paginatekst toe"/>
    <prompt label="Vraag" type="TextArea" height="100" placeholder="Vul hier de vraag of opdracht in"/>
    
    <feedback label="Feedback" type="TextArea" height="100" placeholder="Voeg feedback toe"/>
    <panelWidth label="Paneelbreedte" options="Klein,Medium,Groot,Volledig" type="ComboBox" data="Small,Medium,Large,Full" defaultValue="Medium" width="100"/>
    <align label="Tekst uitlijnen" options="Links,Rechts" type="ComboBox" data="Left,Right" defaultValue="Left" width="100"/>

	<judge label="Beoordeel" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
	<trackingWeight label="Tracking score weging" optional="true" type="textInput" width="120" defaultValue="1.0" condition="judge!='false'" tooltip="Pas de weging van de opdracht op deze pagina aan, ten opzichte van andere gescoorde pagina's in het leerobject. Als je de weging instelt op 0, betekent dit dat de opdracht op deze pagina niet meetelt de totaalscore van het leerobject."/>

    <feedbackBtnTxt label="Label controleerknop" type="TextInput" wysiwyg="true" divider="true" language="true"/>
    <feedbackBtnTip label="Tooltip controleer knop" type="textInput" language="true" deprecated="Deze optie is niet langer vereist"/>	
    <feedbackBtnWidth label="Breedte controleer knop" type="NumericStepper" min="80" max="250" step="10" width="100" defaultValue="100" language="true" deprecated="Breedte is automatisch ingesteld"/>
    <instructHeaderATxt label="Titel instructie (a)" type="TextInput" wysiwyg="true" language="true"/>
    <instructHeaderBTxt label="Titel instructie" type="TextInput" wysiwyg="true" language="true"/>
    <responseHeaderTxt label="Tekst reactie" type="TextInput" wysiwyg="true" language="true"/>
    <noAnswerHeaderTxt label="Geen antwoordtekst" type="TextInput" wysiwyg="true" language="true"/>
    <exampleHeaderTxt label="Tekst feedback" type="TextInput" wysiwyg="true" language="true"/>
	<copyBtnLabel label="Label Selecteerknop" type="TextInput" wysiwyg="true" language="true"/>
    <copyShortcutTxt label="Kopieer snelkoppeling tekst" type="TextInput" wysiwyg="true" language="true"/>
	<answerFieldLabel label="Antwoordveld verborgen Aria-Label" type="TextInput" wysiwyg="false" language="true" mandatory="true" defaultValue="Antwoord" tooltip="Dit is een verborgen label voor screen reader gebruikers zo dat het tekstveld waar ze moeten antwoorden is gelabeld en wordt uitgesproken door de screenreader, bijvoorbeeld: Antwoord."/>

    <copypasteinfo label="Kopieer &amp; plak info (Flash)" defaultValue="Note: the instruction  and question, your response and the example answer, have been copied to the clipboard which you can paste (ctrl + v) into another application such as Open Office, Word or an email to save for future reference." type="TextArea" height="50" optional="true" deprecated="Deze optie is niet langer vereist"/>
	<copypasteinfo2 label="Kopieer &amp; plak" defaultValue="Note: Click the 'Select Text' button to highlight the instruction, question, your response and the example answer and then Ctrl + C to copy this text to the clipboard. You can then paste (Ctrl + V) into another application such as Open Office, Word or an email to save for future reference." type="TextArea" height="50" optional="true"/>
    <label label="Label knop" defaultValue="deprecated - alleen voor backward compatebility" type="TextInput" wysiwyg="true" optional="true" deprecated="Deze optie is niet langer vereist"/>
	
	<required label="Antwoord verplicht" type="CheckBox" optional="true" defaultValue="true"/>
	
	<imgInfo type="group" label="Afbeelding" optional="true">
		<image label="Bestand" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<tooltip label="Omschrijving" type="TextInput" optional="true" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
		<caption label="Onderschrift" type="textInput" optional="true" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
	</imgInfo>

  <resources label="Bronnen bestanden / links" type="DataGrid" gridTxt="&lt;p&gt;Bronnen kunnen URL's, ge&#xFC;ploade bestanden of andere pagina's binnen deze pagina of leerobject zijn.&lt;br /&gt;Voer een URL in, upload een bestand naar het bronveld of selecteer een pagina in het dropdownmenu 'Xerte-paginalink'.&lt;/p&gt;" columns="4" colWidths="20,15,15,50" editable="1,1,1,1" cellType="textInput,media,pageList,textArea" wysiwyg="false,false,false,true" controls="1" headers="Titel,Bron,Xerte Pagina Link,Beschrijving" newRow=",,," defaultValue="|" optional="true" tooltip="Een lijst met aanvullende bronnen met betrekking tot de pagina-inhoud" common="true"/><narrate type="group" label="Audio" optional="true" tooltip="Voeg een audio player toe aan de onderkant van de pagina" common="true">
		<narration label="Audio bestand" type="media" defaultValue="Selecteer een audiobestand" placeholder="Selecteer een audio bestand" optional="true"/>
