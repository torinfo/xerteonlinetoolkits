  </hotspotquestion><iSpring menu="Media" menuItem="iSpring video" hint="Voegt een iSpring video toe aan het leerobject. iSpring video's moeten gepubliceerd zijn in 685 x 514 px." icon="icISpring" thumb="thumbs/ispring.jpg" remove="true" deprecated="Deze pagina wordt niet langer onderhouden">

    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
