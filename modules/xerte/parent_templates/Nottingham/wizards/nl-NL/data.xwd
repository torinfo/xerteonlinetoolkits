        <trackinglabel label="Trackinglabel" type="TextInput" wysiwyg="false" optional="true" tooltip="In plaats van paginanummer het label als tracking identifier gebruiken (SCORM en xAPI)"/>
        <grouping label="Track groepering" type="Grouping" optional="true" tooltip="Label voor groepering van xAPI events, om te gebruiken voor groepering in xAPI rapporten"/>
