  </listItem><map icon="icMap" menu="Overig" menuItem="Google Map" hint="Gebruik Google Map om een interactieve kaart aan het leerobject toe te voegen. Er kunnen optioneel lagen van KML data aan de kaart worden toegevoegd.&lt;br&gt;" thumb="thumbs/googleMap.jpg" remove="true" deprecated="Deze pagina wordt niet langer onderhouden">

    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
