		<movieSize label="Grootte" type="textInput" defaultValue="" placeholder="bijv. 320,240" optional="true" tooltip="By default videos will be scaled automatically to best fit on the page. This option fixes the video size (width,height). Use with caution!"/>
	</videoInfo>

