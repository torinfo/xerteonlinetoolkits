		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
		<lightbox type="CheckBox" label="Lightbox afbeeldingen" defaultValue="true" conditionTrigger="true" optional="true"/>
		<lightboxCaption type="ComboBox" label="Onderschrift" defaultValue="false" condition="lightbox=='true'" optional="true" options="Geen,Onder afbeelding,Boven afbeelding" data="false,below,above" tooltip="Voeg een onderschrift toe aan lightbox-afbeeldingen op deze pagina. De onderschrifttekst is afkomstig uit de velden 'Beschrijving' of 'Alt-tekst'."/>
	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></accNav><nestedPage menuItem="Sub-pagina" icon="icBullet" remove="true">

    <name label="Titel" type="TextInput" wysiwyg="true"/>
    <text label="Tekst" type="TextArea" height="250" placeholder="Voeg tekst voor de sub-pagina toe"/>
    <align label="Tekst uitlijnen" options="Boven,Onder" type="ComboBox" data="Top,Bottom" defaultValue="Top" width="100"/>

    <imgInfo type="group" label="Afbeelding" optional="true">
      <url label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
      <tip label="Omschrijving" type="textInput" optional="true" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
      <caption label="Onderschrift" type="textInput" optional="true" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
    </imgInfo>

    <initObject label="Init Object" type="TextInput" optional="true" flashonly="true" deprecated="Deze eigenschap is verouderd."/>
    <movieSize label="Video grootte (b,h)" type="textInput" defaultValue="300,300" optional="true" deprecated="Deze eigenschap is verouderd."/>
    <synch label="Synchronisatiepunt" type="TextInput"/><!-- for backwards compatibility with templates that used to use nestedPage -->

  </nestedPage><adaptiveContent menu="Tracking / xAPI" menuItem="Adaptieve content" hint="Een pagina waar je Xerte resultaten van xAPI en LRS kunt ophalen. Deze adaptieve content komt van scores of eerder ingevulde pagina's in Xerte. Gebaseerd op deze scores kun je alternatieven tonen." icon="icAdaptiveContent" thumb="thumbs/adaptiveContent.jpg" wiki="https://xerte.org.uk/wiki/doku.php?id=trackingxapi_adaptivecontent_page" remove="true">
      <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
      <introduction label="Pagina tekst" type="textArea" height="120" placeholder="Voeg paginatekst toe"/>
      <displayMode label="Weergave modus" conditionTrigger="true" optional="true" type="combobox" options="Geen geordende lijst,Geordende lijst" data="Unlisted,Listed" defaultValue="Unlisted"/>
      <startDate label="Start datum" optional="true" type="dateField" defaultValue="" tooltip="Bekijk gegevens vanaf deze datum"/>
      <endDate label="Stop datum" optional="true" type="dateField" defaultValue="" tooltip="Bekijk gegevens tot deze datum"/>
     <dashboardMode label="Dashboard modus" optional="true" type="checkbox" defaultValue="false" tooltip="Toon gegevens van de hele groep. Toon geen gegevens van de specifieke deelnemer."/>
      <disableprinting label="Printen PDF uitzetten" type="CheckBox" optional="true" defaultValue="false"/>
     <listedModeOptions type="group" condition="displayMode=='Listed'" optional="true" label="Opties weergave modus 'Geordende lijst'" tooltip="Extra opties die alleen beschikbaar zijn voor de weergave modus 'Geordende lijst'">
         <sortOrder label="Sorteer volgorde" optional="true" type="combobox" defaultValue="none" options="Oplopend,Aflopend,Geen" data="increasing,decreasing,none" tooltip="Sorteer de lijst volgens deze criteria. Is alleen beschikbaar voor de weergave modus 'Geordende lijst'"/>
     </listedModeOptions>
     <periodGroup type="group" optional="true" label="Opties voor gebruik periodes">
        <multiPeriodVersion label="Selecteer versie periode" type="combobox" conditionTrigger="true" options="Uitgeschakeld,Statische periodes,Dynamische periodes (op aanvraag), Dynamische periodes (altijd)" data="off,static,dynamic,dynamic_always" defaultValue="off" optional="true"/>
        <period0Date label="Van " type="DateField" defaultValue="" optional="true" allowBlank="false" condition="multiPeriodVersion=='static'" conditionTrigger="true" tooltip="Gebruik de kalender om een datum te selecteren (format YYYY-MM-DD)"/>
        <period0UntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="false" condition="multiPeriodVersion=='static'" conditionTrigger="true" tooltip="Gebruik de kalender om een datum te selecteren (format YYYY-MM-DD)"/>
        <period1 label="Gebruik tweede periode" type="CheckBox" defaultValue="false" optional="true" condition="multiPeriodVersion=='static'"/>
        <period1Date label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="multiPeriodVersion=='static'" conditionTrigger="true" tooltip="Gebruik de kalender om een datum te selecteren (format YYYY-MM-DD)"/>
        <period1UntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="multiPeriodVersion=='static'" conditionTrigger="true" tooltip="Gebruik de kalender om een datum te selecteren (format YYYY-MM-DD)"/>
        <period2 label="Gebruik de derde periode" type="CheckBox" defaultValue="false" optional="true" condition="multiPeriodVersion=='static'"/>
        <period2Date label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="multiPeriodVersion=='static'" conditionTrigger="true" tooltip="Gebruik de kalender om een datum te selecteren (format YYYY-MM-DD)"/>
        <period2UntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="multiPeriodVersion=='static'" conditionTrigger="true" tooltip="Gebruik de kalender om een datum te selecteren (format YYYY-MM-DD)"/>

     </periodGroup>

      <newNodes>
        <interaction><![CDATA[<interaction acpWarning="" name="Voeg titel toe" introduction="" label="" interactionType="score" scoreText="Jouw score is {0}" answerText="Jouw antwoord is {0}" AvgScoreText="De gemiddelde score is {0}" NrParticipantsText="Het aantal deelnames is {0}" myOpenAnswerText="Mijn antwoorden" allOpenAnswerText="Alle antwoorden" xAxisLabelBarAnswers="X-as label antwoord staafdiagram" yAxisLabelBarAnswers="Percentage antwoorden" xAxisLabelBarMarks="Score bereik [%]" yAxisLabelBarMarks="% van de groep" y2AxisLabelBarMarks="Score [%]" yAxisLabelBarScore="Gemiddelde score van alle pogingen" xAxisLabelLineAvgMarks="Score bereik [%]" yAxisLabelLineAvgMarks="% van de groep" xAxisLabelLineOwnMarks="Datum" yAxisLabelLineOwnMarks="Cijfer [0-10]" ownScoreLabelBarMarks="Jouw score" avgScoreLabelBarMarks="Gemiddelde score in deze groep" groupUserLabel="deelnemers in groep" groupScore="Gemiddelde score" userScore="Score lerende" insufficientDataText="Er is te weining data voor deze grafiek." notWorkingInDashboardMode="Deze grafiek werkt niet in dashboard modus." personalAvgLabelText="Gemiddelde van jouw pogingen" personalLabelText="Jouw laatste poging" avgAllLabelText="Gemiddelde van alle pogingen" groupAverageLabelText="Groep gemiddelde" SummaryText="Samenvatting" NrQuestionsText="Aantal vragen is {0}" NrCorrectQuestionsText="Totaal juiste antwoorden {0}" SpecificationText="Specificatie" AdviceText="Advies" CorrectText="Juist" IncorrectText="Onjuist" PassingGrade="75"/>]]>
        </interaction>
      </newNodes>
    <resources label="Bronnen bestanden / links" type="DataGrid" gridTxt="&lt;p&gt;Bronnen kunnen URL's, ge&#xFC;ploade bestanden of andere pagina's binnen deze pagina of leerobject zijn.&lt;br /&gt;Voer een URL in, upload een bestand naar het bronveld of selecteer een pagina in het dropdownmenu 'Xerte-paginalink'.&lt;/p&gt;" columns="4" colWidths="20,15,15,50" editable="1,1,1,1" cellType="textInput,media,pageList,textArea" wysiwyg="false,false,false,true" controls="1" headers="Titel,Bron,Xerte Pagina Link,Beschrijving" newRow=",,," defaultValue="|" optional="true" tooltip="Een lijst met aanvullende bronnen met betrekking tot de pagina-inhoud" common="true"/><narrate type="group" label="Audio" optional="true" tooltip="Voeg een audio player toe aan de onderkant van de pagina" common="true">
		<narration label="Audio bestand" type="media" defaultValue="Selecteer een audiobestand" placeholder="Selecteer een audio bestand" optional="true"/>
		<narrationTranscript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er wordt een transcriptknop toegevoegd aan de audiobalk wanneer transcripttekst is opgenomen"/>    
		<playNarration label="Auto-Play" type="CheckBox" defaultValue="false" optional="true" tooltip="Speel automatisch af wanneer de pagina wordt bekeken. NB.: sommige browsers staan automatisch afspelen niet toe"/>
		<narrationNavigate label="Navigeer aan het einde" type="CheckBox" defaultValue="false" optional="true" tooltip="Ga automatisch naar de volgende pagina wanneer de audio afgelopen is"/>
	</narrate><navSetting label="Navigatie knoppen" options="Alle,Vorige en volgende,Alleen terug,Alleen volgende,Geen" type="ComboBox" width="120" data="all,backnext,backonly,nextonly,none" defaultValue="all" optional="true" deprecated="Deze optie wordt niet meer gebruikt in deze XOT versie. Gebruik de nieuwe groep Navigatie knoppen (optionele eigenschap) om deze in te stellen." common="true"/><navBtns type="group" label="Navigatie knoppen" optional="true" tooltip="Schakel de individuele navigatieknoppen op deze pagina uit" info="Het standaard beschikbaar hebben van alle navigatie knoppen op iedere pagina hangt af van de navigatie instelling van het leerobject. Deactiveer knoppen op de individuele pagina's door deze te selecteren op die pagina." common="true">
		<home label="Home / Menu knop" type="CheckBox" defaultValue="true" optional="true"/>
		<back label="Terug / Vorige knop" type="CheckBox" defaultValue="true" optional="true"/>
		<next label="Volgende knop" type="CheckBox" defaultValue="true" optional="true"/>
		<save label="Sessie opslaan knop" type="CheckBox" defaultValue="true" optional="true"/>
	</navBtns><hideShow type="group" label="Verberg/Toon pagina" optional="true" tooltip="GEEF EEN BESCHRIJVING HIER..." info="Je kunt deze pagina altijd verbergen door de velden 'Van' en 'Tot' leeg te laten. Je kunt ook een datum (en eventueel een tijd) opgeven in de velden 'Van' en 'Tot' om aan te geven wanneer de pagina beschikbaar moet zijn." common="true">
		<hidePage label="Verberg pagina" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideOnTime label="Van (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideOnDate!=''&amp;&amp;hideOnDate!=undefined"/>
		<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideUntilTime label="Tot (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideUntilDate!=''&amp;&amp;hideUntilDate!=undefined"/>
	</hideShow><linkGroup type="group" label="Stand-alone pagina" optional="true" tooltip="Verwijder pagina van menu zodat je alleen via Xertelinks toegang hebt." common="true">
		<linkPage label="Stand-alone" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<linkTarget label="Open in" type="ComboBox" data="same,new,lightbox" options="Zelfde venster,Nieuw venster,Lightbox" defaultValue="lightbox" condition="linkPage=='true'" optional="true" tooltip="Geeft aan hoe de link naar deze pagina wordt geopend"/>
		<headerHide label="Verberg header" type="Checkbox" defaultValue="false" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de headerbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bijvoorbeeld bekijkt in een lightbox."/>
		<footerHide label="Verberg Voetbalk" type="CheckBox" defaultValue="true" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de voetbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bekijkt in een lightbox."/>
		<reqProgress label="Opnemen in de voortgangbalk" type="CheckBox" defaultValue="false" condition="linkPage=='true'&amp;&amp;(treeroot.progressBar!=undefined||treeroot.progressBarType=='true'||((treeroot.progressBarType=='header1'||treeroot.progressBarType=='header2'||treeroot.progressBarType=='header3')&amp;&amp;treeroot.progressSub=='false'))" optional="true" tooltip="Standaard worden stand-alone pagina's uitgesloten van het voltooiings percentage op de voortgangsbalk. Vink deze optie aan om deze pagina wel op te nemen in de voortgang van het leerobject."/>
	</linkGroup><passwordGroup type="group" label="Toegangscode" optional="true" tooltip="De toegang tot deze pagina is beperkt totdat een toegangscode wordt ingevoerd. Let op: om het leerobject veilig te beschermen, moet je de beveiliging regelen via het tabblad Toegang in de leerobject eigenschappen in plaats van deze optionele eigenschap te gebruiken. Deze functie is vooral bedoeld voor het ontsluiten van nieuw materiaal en niet voor beveiliging volgens de AVG." common="true">
		<password label="Toegangscode(s)" type="TextInput" optional="true" defaultValue="" tooltip="Een komma gescheiden lijst met toegangscodes die toegang geven tot deze site"/>
		<passwordCase label="Hoofdletter gevoelig" type="CheckBox" optional="true" defaultValue="true" tooltip="De toegangscodes zijn hoofdletter gevoelig wanneer deze optie is aangevinkt"/>
		<passwordType label="Type" type="ComboBox" data="standard,centered,vault,vaultnumeric" options="Standaard,Standaard midden,Kluis,Toetsenbord" optional="true" defaultValue="standard" tooltip="Pas het uiterlijk van de toegangscode-informatie op de pagina aan. De toegangscode moet numeriek zijn wanneer 'Toetsenbord' wordt gebruikt."/>
		<passwordInfo label="Instructies" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Enter an access code below to view the page:&lt;/p&gt;" tooltip="De instructies die verschijnen in het toegangscode venster"/>
		<passwordError label="Foutmelding" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Invalid access code&lt;/p&gt;" tooltip="De foutmelding die verschijnt wanneer de verkeerde toegangscode wordt gebruikt"/>
		<passwordSubmit label="Label knop" type="TextInput" optional="true" defaultValue="Controleer" tooltip="Het label van de vul toegangscode in knop"/>
	</passwordGroup><introGroup type="group" label="Introductie" optional="true" tooltip="Voeg een Pagina-introductie knop toe aan de voetbalk die informatie in een lightbox opent, wanneer erop wordt geklikt. Deze introductie kan worden ingesteld om automatisch te openen wanneer de pagina voor het eerst wordt geladen." common="true">
		<introType type="ComboBox" label="Content type" defaultValue="text" options="Tekst,Afbeelding,Video,URL,Bestand" data="text,image,video,url,file" conditionTrigger="true" optional="true" tooltip="Het type inhoud dat wordt gebruikt als introductie voor deze pagina"/>
		<pageIntro label="Tekst" type="TextArea" height="100" defaultValue="" condition="introType=='text'||introType==undefined" optional="true"/>
		<introImg label="Afbeelding" type="media" height="100" defaultValue="" condition="introType=='image'" optional="true" placeholder="Selecteer afbeelding"/>
		<introVideo label="Video" type="media" height="100" defaultValue="" condition="introType=='video'" optional="true" placeholder="Selecteer een videobestand of voer een url/embedcode in"/>
		<introTip label="Omschrijving" type="TextInput" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)." condition="introType=='image'||introType=='video'" optional="true"/>
		<introCaption label="Onderschrift" type="TextInput" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" condition="introType=='image'" optional="true" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
		<introURL label="URL" type="TextInput" defaultValue="" condition="introType=='url'" optional="true" placeholder="Voeg een URL toe"/>
		<introFile label="Bestand" type="media" height="100" defaultValue="" condition="introType=='file'" optional="true" placeholder="Selecteer een bestand (bijvoorbeeld een PDF)"/>
		<introTitle type="CheckBox" label="Weergeven titel" defaultValue="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Toon de paginatitel boven de introductietekst"/>
		<introBtn type="CheckBox" label="Start knop" defaultValue="true" conditionTrigger="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Voeg een 'start'-knop toe onder de introductietekst die de lightbox sluit wanneer erop wordt geklikt"/>
		<introBtnTxt label="Tekst knop" type="TextInput" defaultValue="Start" condition="introBtn=='true'&amp;&amp;(introType=='text'||introType==undefined||introType=='image')" wysiwyg="true" optional="true"/>
		<introWidth label="Breedte lightbox" options="Auto,Klein,Medium,Groot,Volledig" type="ComboBox" data="Auto,Small,Medium,Large,Full" defaultValue="Auto" condition="introType=='text'||introType==undefined" optional="true"/>
		<introShow type="ComboBox" label="Open automatisch" defaultValue="first" options="Elke keer dat deze pagina wordt bekeken,De eerste keer dat deze pagina wordt bekeken,Nooit" data="always,first,never" optional="true" tooltip="Geef op of de introductie automatisch wordt geopend wanneer de pagina wordt bekeken"/>
	</introGroup><customLinkGroup type="group" label="Pagina ID" optional="true" tooltip="Maak een aangepaste URL voor deze pagina" info="&lt;p&gt;Maak een directe link naar deze pagina door #jePaginaID toe te voegen aan het einde van de project-URL.&lt;br /&gt;Vermijd het gebruik van spaties, speciale tekens en het woord 'page' in ID's en zorg ervoor dat elke ID uniek is binnen het hele project.&lt;br /&gt;ID's zijn hoofdlettergevoelig.&lt;/p&gt;" common="true">
		<pageID label="Pagina ID" type="TextInput" optional="true"/>
	</customLinkGroup><unmarkForCompletion label="Voltooiing niet verplicht" type="CheckBox" defaultValue="true" tooltip="Wanneer het leerobject wordt getrackt (bijvoorbeeld met behulp van SCORM of xAPI), selecteer 'afronding niet verplicht' wanneer de pagina niet voltooid hoeft te worden, zodat het leerobject als voltooid kan worden gemarkeerd." optional="true" common="true"/><disableGlossary label="Woordenlijst uitzetten" defaultValue="true" type="CheckBox" condition="treeroot.glossary!=undefined" optional="true" tooltip="Voorkom dat woorden uit de woordenlijst op deze pagina worden getoond" common="true"/><styles label="Stijl" type="script" height="200" optional="true" tooltip="Voeg op maat gemaakte CSS toe aan deze pagina" common="true"/><tracking type="group" label="Tracking" optional="true" tooltip="Eigenschappen met betrekking tot tracked leerobjecten (bijvoorbeeld SCORM or xAPI)" common="true">
        <trackinglabel label="Trackinglabel" type="TextInput" wysiwyg="false" optional="true" tooltip="In plaats van paginanummer het label als tracking identifier gebruiken (SCORM en xAPI)"/>
        <grouping label="Track groepering" type="Grouping" optional="true" tooltip="Label voor groepering van xAPI events, om te gebruiken voor groepering in xAPI rapporten"/>
	</tracking><scripts type="group" label="Script" optional="true" tooltip="Voeg JavaScript toe die bij de eerste keer dat deze pagina geladen wordt of iedere keer dat deze pagina geladen wordt, wordt uitgevoerd " common="true">
		<script label="Script" type="script" height="200" defaultValue="// JavaScript / jQuery" optional="true"/>
		<run label="Uitvoeren" options="Alleen de eerste keer dat de pagina wordt bekeken,Iedere keer dat de pagina wordt bekeken" type="ComboBox" width="120" data="first,all" defaultValue="first" optional="true"/>
	</scripts><background type="group" label="Achtergrond" optional="true" tooltip="Voeg een achtergrondafbeelding toe aan deze pagina. Dit overschrijft elke achtergrondafbeelding die op leerobjectniveau is toegevoegd." common="true">
		<bgImage label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<backgroundFit optional="true" type="ComboBox" options="Uitrekken om te passen,Bijsnijden om te passen,Hele afbeelding tonen" data="fill,cover,contain" defaultValue="cover" label="Afbeelding schaal" tooltip="Hoe de achtergrondafbeelding de beschikbare ruimte vult. 'Uitrekken om te passen' zal de afbeelding verticaal of horizontaal uitrekken om de ruimte te vullen, 'Bijsnijden om te passen' zal de afbeelding bijsnijden om te passen zonder deze te vervormen en 'Hele afbeelding weergeven' zal de volledige geschaalde afbeelding weergeven zonder deze te vervormen. Let op: dit heeft geen effect in Internet Explorer."/>
		<bgImageAlpha label="Doorzichtigheid" type="NumericStepper" min="0" max="100" step="10" defaultValue="30" optional="true" tooltip="De dekking van de afbeelding, waarbij 0 volledig transparant is en 100 helemaal niet transparant is."/>
		<bgImageDark optional="true" type="NumericStepper" min="0" max="100" step="1" defaultValue="0" label="Donkerheid" tooltip="Voeg een filter toe om de afbeelding donkerder te maken. 0 is niet donker en 100 is volledig donker (zwart)."/>
		<bgImageGrey optional="true" type="CheckBox" label="Grijsschaal" defaultValue="false" tooltip="Voeg een filter toe om de kleur van de afbeelding te veranderen naar een grijsschaal."/>
	</background><pageTimer type="group" label="Pagina timer" optional="true" tooltip="Voeg een timer toe aan de pagina, tel terug naar 0" common="true">
		<showTimer label="Toon timer" optional="true" type="CheckBox" defaultValue="true" conditionTrigger="true"/>
		<timer label="Toon limiet (seconden)" defaultValue="60" type="NumericStepper" min="0" step="1" width="100" condition="showTimer=='true'" optional="true"/>
		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
		<lightbox type="CheckBox" label="Lightbox afbeeldingen" defaultValue="true" conditionTrigger="true" optional="true"/>
		<lightboxCaption type="ComboBox" label="Onderschrift" defaultValue="false" condition="lightbox=='true'" optional="true" options="Geen,Onder afbeelding,Boven afbeelding" data="false,below,above" tooltip="Voeg een onderschrift toe aan lightbox-afbeeldingen op deze pagina. De onderschrifttekst is afkomstig uit de velden 'Beschrijving' of 'Alt-tekst'."/>
	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></adaptiveContent><interaction menuItem="Bron interactie">
        <name label="Titel" type="textinput" wysiwyg="true"/>
        <introduction label="Introductie" type="textarea" height="120" wysiwyg="true" placeholder="Voeg introductie toe"/>
        <interactionType label="Interactie type" type="combobox" conditionTrigger="true" data="score,answer,opinion,open,grouping,groupings,opinionclasses" options="Gebaseerd op score,Gebaseerd op specifiek antwoord,Gebaseerd op opinie,Gebaseerd op model antwoord,Gebaseerd op grouping,Gebaseerd op alle groupings, Gebaseerd op alle classes" tooltip="&lt;p&gt;Gebaseerd op score: Gebruik de optionele eigenschap 'Score tussen' om &#xE9;&#xE9;n of meer interactieblokken toe te voegen.&lt;br /&gt;Gebaseerd op antwoord: Gebruik de optionele eigenschap 'Antwoordlabel is gelijk aan' om &#xE9;&#xE9;n of meer interactieblokken toe te voegen.&lt;br /&gt;Gebaseerd op opinie pagina: Gebruik in combinatie met de optionele eigenschap groep om een score op te halen.&lt;br /&gt;Gebaseerd op open antwoord: Toont slechts &#xE9;&#xE9;n interactieblok met alle gegeven antwoorden (alle gegeven interactieblokken worden gewoon genegeerd).&lt;/p&gt;"/>
        <sourceGroup label="Bron leerobject" type="group" optional="true">
          <xerteurl label="URL van de Xerte bron installatie" type="xerteurl" optional="true" defaultValue="" placeholder="Voer de Xerte-installatie van het bron-Xerte-leerobject in. Dat is normaal gesproken deze installatie maar kan ook naar een andere installatie verwijzen."/>
          <xertelo label="ID van Xerte leerobject" type="xertelo" optional="true" defaultValue="" placeholder="Voer het id van het bron Xerte leerobject in."/>
        </sourceGroup>
        <label label="Trackinglabel bron" type="TextInput" condition="interactionType!='grouping'" wysiwyg="false"/>
        <grouping label="Groepering is gelijk aan" type="Grouping" mandatory="true" defaultValue="" condition="interactionType=='grouping'" tooltip="Bij iedere interactie kan een groepering aangegeven worden. Kies hier vervolgens de groepering waaruit je de score wilt ophalen. Meer dan &#xE9;&#xE9;n pagina kan deel uitmaken van dezelfde groepering en vervolgens wordt de gemiddelde score over deze pagina's gebruikt"/>
        <opinionClass label="Opinie klasse" type="TextInput" condition="interactionType=='score'" wysiwyg="false" optional="true" defaultValue="Voeg label van klasse toe" placeholder="Voeg label van de klasse toe" tooltip="Voeg de label van de opinie klasse toe om als score te gebruiken wanneer het interactietype is gebaseerd op score en de score komt van de opinie pagina"/>
        <sessionStatementUsed label="Welk(e) antwoord(en) gebruiken van sessie/deelnemer" condition="interactionType!='opinionclasses'&amp;&amp;interactionType!='groupings'&amp;&amp;interactionType!='grouping'" type="combobox" data="first,last,best,all" options="Eerste,Laatste,Beste,Allemaal" defaultValue="all" optional="true" tooltip="Welk antwoord moet gebruikt worden wanneer een deelnemer een vraag meerdere keren heeft beantwoord binnen eenzelfde sessie."/>
        <acpWarning label="Let op: De Adaptieve Content pagina werkt niet wanneer je de normale 'play' link gebruikt. Om de pagina correct te bekijken, gebruik je de xAPI/LTI-link in de Xerte-werkruimte. Als er geen xAPI/LTI-link beschikbaar is, is de installatie mogelijk niet voltooid. Raadpleeg in dat geval de handleiding of wiki van de Adaptieve Content pagina voor installatie-instructies of vraag het na bij jouw beheerder." type="info"/>
        <graphgroup type="group" label="Grafiek" condition="interactionType!='open'" optional="true">
          <graph label="Toon grafiek" type="checkbox" defaultValue="false" optional="true"/>

          <graphType label="Grafiek type" type="combobox" conditionTrigger="true" condition="interactionType=='score'" data="bar_marks,bar_marks_score,bar_comb_marks,line_own_marks,line_average_marks" options="Staafdiagram van score,Staafdiagram voor gemiddelde sores,Staafdiagram voor gecombineerde score,Lijndiagram voor eigen score,Lijndiagram van gemiddelde score van anderen" defaultValue="bar_marks" optional="true"/>

          <answerGraphType label="Grafiek type" type="combobox" condition="interactionType=='answer'" data="bar_answers,test2" options="Staafdiagram voor gegeven antwoorden," defaultValue="bar_answers" optional="true"/>

          <groupGraphType label="Grafiek type" type="combobox" conditionTrigger="true" condition="interactionType=='grouping' || interactionType=='groupings' || interactionType=='opinionclasses'" data="bar_answers,bar_marks,bar_marks_score,bar_comb_marks,hor_bar_comb_marks,hor_bar_comb_marks_avg,pie_marks,line_own_marks,line_average_marks,polar_area_per_category" options="Staafdiagram voor gegeven antwoorden,Staafdiagram van score,Staafdiagram van gemiddelde score,Staafdiagram van gecombineerde score,Horizontaal staafdiagram van gecombineerde score,Horizontale staafdiagram met gemiddelden,Cirkeldiagram van score,Lijndiagram van eigen score,Lijndiagram van de score van anderen,Polardiagram voor categorieoverzicht" defaultValue="bar_answers" optional="true"/>

          <opinionGraphType label="Grafiek type" type="combobox" conditionTrigger="true" condition="interactionType=='opinion'" data="radar,hor_bar_comb_marks_avg" options="Radardiagram,Horizontale staafdiagram met gemiddelden" defaultValue="radar" optional="true"/>

          <opinionRadarData label="Radardiagram data" type="combobox" conditionTrigger="true" condition="interactionType=='opinion'&amp;&amp;opinionGraphType=='radar'" optional="true" defaultValue="personal" data="personal,group" options="Persoonlijk (laatste poging%%2C persoonlijk gemiddelde%%2C groepsgemiddelde),Groep (laatste poging van iedere deelnemer%%2C groepsgemiddelde)" tooltip="Welke data moet getoond worden het radardiagram?"/>
          <colour label="Persoonlijke grafiek" type="colourPicker" condition="interactionType=='opinion'&amp;&amp;opinionClass==null&amp;&amp;opinionGraphType=='radar'&amp;&amp;opinionRadarData!='group'" defaultValue="0xFF0000" optional="true"/>
          <colourPersonalAvg label="Persoonlijk gemiddelde grafiek" type="colourPicker" condition="interactionType=='opinion'&amp;&amp;opinionClass==null&amp;&amp;opinionGraphType=='radar'&amp;&amp;opinionRadarData!='group'" defaultValue="0x0000FF" optional="true"/>
          <colourAvg label="Gemiddelde grafiek" type="colourPicker" condition="interactionType=='opinion'&amp;&amp;opinionClass==null&amp;&amp;opinionGraphType=='radar'" defaultValue="0x00FF00" optional="true"/>
          <labelFontSize label="Labels lettergrootte" type="NumericStepper" min="4" max="100" step="1" condition="interactionType=='opinion'&amp;&amp;opinionClass==null&amp;&amp;opinionGraphType=='radar'" defaultValue="12" optional="true"/>
          <graphFollowBlock label="Gebruik blokinstellingen voor staafgrafiek" type="checkbox" optional="true" defaultValue="false" conditionTrigger="true" condition="(interactionType!='opinion'||opinionClass!=null) &amp;&amp; ((graphType=='bar_marks' || graphType=='bar_marks_score') &amp;&amp; interactionType=='score' || (groupGraphType=='bar_marks' || groupGraphType=='bar_marks_score') &amp;&amp; (interactionType=='grouping' || interactionType=='groupings' || interactionType=='opinionclasses'))" tooltip="Gebruik het aantal interactieblokken en de bijbehorende grenzen als defenitie voor de staven van de staafgrafiek."/>
          <graphNrDataPoints label="Aantal staven/punten" type="NumericStepper" min="0" max="100" step="1" defaultValue="10" optional="true" condition="(interactionType!='opinion'||opinionClass!=null) &amp;&amp; graphFollowBlock!='true'" tooltip="Het aantal staven van de staafdiagram, of het aantal punten in de lijndiagram"/>
          <graphShowAvg label="Toon gemiddelde" type="checkbox" defaultValue="false" optional="true" condition="(graphType=='bar_marks' &amp;&amp; interactionType=='score') || ( groupGraphType=='bar_marks' &amp;&amp; (interactionType=='grouping' || interactionType=='groupings' || interactionType=='opinionclasses'))"/>
          <graphShowScore label="Toon score lerende" type="checkbox" defaultValue="false" optional="true" condition="(graphType=='bar_marks' &amp;&amp; interactionType=='score') || ( groupGraphType=='bar_marks' &amp;&amp; (interactionType=='grouping' || interactionType=='groupings' || interactionType=='opinionclasses'))"/>
          <graphShowAvgBar label="Toon het gemiddelde en de score met een staaf" type="checkbox" defaultValue="false" optional="true" condition="(graphType=='bar_marks' &amp;&amp; interactionType=='score') || ( groupGraphType=='bar_marks' &amp;&amp; (interactionType=='grouping' || interactionType=='groupings' || interactionType=='opinionclasses'))" tooltip="Voegt een lijn toe aan de grafiek voor de gemiddelde score en de gebruikersscore."/>
          <graphFitInfoInBar label="Toon info in een staaf" type="checkbox" defaultValue="false" optional="true" condition="(graphType=='bar_marks' &amp;&amp; interactionType=='score') || ( groupGraphType=='bar_marks' &amp;&amp; (interactionType=='grouping' || interactionType=='groupings' || interactionType=='opinionclasses'))" tooltip="Schaalt de gebruikerscore en het gemiddelde en geeft deze weer in de balken."/>
          <graphColorScale label="Kleurenschaal" type="textInput" wysiwyg="false" defaultValue="#FF6384,#4BC0C0,#FFCD56,#C9CBCF,#36A2EB,#B284BE" optional="true" condition="((interactionType!='opinion'||opinionClass!=null) &amp;&amp; graphType=='polar_area_per_category')||(interactionType=='opinion' &amp;&amp; opinionClass==null &amp;&amp; (opinionGraphType=='hor_bar_comb_marks_avg'||opinionRadarData=='group'))" tooltip="De kleuren schaal voor de voor de staven in de (horizontale) staafdiagram, of voor de polar diagram"/>
          <explanationGroup type="group" label="Legend / Explanation" optional="true" tooltip="Een vak met een legenda of andere uitleg naast de grafiek">
            <showExplanation label="Toon legenda" type="checkbox" optional="true" defaultValue="false" tooltip="Toont een legenda/ uitleg"/>
            <graphExplanation label="Tekst legenda" type="textArea" height="120" optional="true" defaultValue="" wysiwyg="true" tooltip="De legenda of uitleg die naast de grafiek wordt getoond."/>
            <graphExplanationPanelWidth label="Paneelbreedte" type="textInput" defaultValue="40%" optional="true" tooltip="The width of the legend or other explanation panel, enter an acceptable width like 40% or 250px"/>
          </explanationGroup>

        </graphgroup>
        <showScore label="Toon score/antwoord" type="CheckBox" condition="interactionType=='score'||interactionType=='answer'||(interactionType=='opinion' &amp;&amp; opinionClass!=null)||interactionType=='grouping'||interactionType=='groupings'||interactionType=='opinionclasses'" optional="true" defaultValue="false" tooltip="Toont de score of antwoord van de deelnemer waarop de interactieblokken zijn gebaseerd."/>
        <scoreText label="Score tekst" type="TextInput" wysiwyg="true" language="true"/>
        <answerText label="Antwoord tekst" type="TextInput" wysiwyg="true" language="true"/>
        <!-- <showAvgScore label="Show average score" type="CheckBox" optional="true" defaultValue="false" tooltip="Show the average score of the whole group" /> -->
        <SummaryText label="Samenvatting titel" type="TextInput" wysiwyg="true" language="true"/>
        <AvgScoreText label="Label gemiddelde score" type="TextInput" wysiwyg="true" language="true"/>
        <showNrOfParticipants label="Toon aantal deelnames" type="CheckBox" optional="true" defaultValue="false" tooltip="Toon het aantal deelnames van deze groep"/>
        <NrParticipantsText label="Label aantal deelnemer" type="TextInput" wysiwyg="true" language="true"/>
        <showOtherBlockContent label="Toon inhoud van andere blokken" type="CheckBox" optional="true" defaultValue="false" tooltip="lerende toestaan &#x200B;&#x200B;om (optioneel) de inhoud van alle blokken te zien"/>
        <showNrOfQuestions label="Toon aantal vragen" condition="interactionType=='grouping'" type="CheckBox" optional="true" defaultValue="false" tooltip="Toon aantal vragen van deze groep"/>
        <NrQuestionsText label="Label aantal vragen" type="TextInput" wysiwyg="true" language="true"/>
        <showNrOfCorrectQuestions label="Toon aantal correcte vragen" condition="interactionType=='grouping'" type="CheckBox" optional="true" defaultValue="false" tooltip="Toon aantal correcte vragen van deze groep"/>
        <NrCorrectQuestionsText label="Label aantal correcte vragen" type="TextInput" wysiwyg="true" language="true"/>
        <showSpecification label="Toon specificaties" condition="interactionType=='grouping'" type="CheckBox" optional="true" defaultValue="false" tooltip="Toon specificatie vraag"/>
        <SpecificationText label="Titel specificatie vraag" type="TextInput" wysiwyg="true" language="true"/>
        <AdviceText label="Titel advies" type="TextInput" wysiwyg="true" language="true"/>
        <CorrectText label="Label juiste antwoord" type="TextInput" wysiwyg="true" language="true"/>
        <IncorrectText label="Label onjuiste antwoord" type="TextInput" wysiwyg="true" language="true"/>
        <PassingGrade label="Slaging percentage" type="TextInput" wysiwyg="true" language="true"/>
        <listedModeOptions type="group" optional="true" condition="parent.displayMode=='Listed'" label="Opties weergave modus 'Geordende lijst'" tooltip="Extra opties die alleen beschikbaar zijn voor de weergave modus 'Geordende lijst'">
            <doNotSort label="Dit item niet mee sorteren" type="checkbox" defaultValue="false" optional="true" tooltip="Dit item niet mee sorteren in de geordende lijst. Dit item behoudt dan de standaard lokatie. Gebruik bijvoorbeeld om een interactie blok boven aan de pagina vast te zetten."/>
        </listedModeOptions>

        <xAxisLabelBarAnswers label="X-as label van antwoord staafdiagram" type="TextInput" language="true"/>
        <yAxisLabelBarAnswers label="Y-as label antwoord staafdiagram" type="TextInput" language="true"/>
        <xAxisLabelBarMarks label="X-as label van score in staafdiagram" type="TextInput" language="true"/>
        <yAxisLabelBarMarks label="Y-as label van score in staafdiagram" type="TextInput" language="true"/>
        <y2AxisLabelBarMarks label="Tweede Y-as label score staafgrafiek" type="TextInput" language="true"/>
        <xAxisLabelBarScore label="X-as label van score in staafdiagram" type="TextInput" language="true"/>
        <yAxisLabelBarScore label="Y-as label van score in staafdiagram" type="TextInput" language="true"/>
        <xAxisLabelLineAvgMarks label="X-as label van gemiddelde in lijndiagram" type="TextInput" language="true"/>
        <yAxisLabelLineAvgMarks label="Y-as label van gemiddelde score in lijndiagram" type="TextInput" language="true"/>
        <xAxisLabelLineOwnMarks label="X-as label van eigen score in lijndigram" type="TextInput" language="true"/>
        <yAxisLabelLineOwnMarks label="Y-as label van eigen score in lijndiagram" type="TextInput" language="true"/>
        <ownScoreLabelBarMarks label="Label voor score van de lerende in de grafiek" type="TextInput" language="true"/>
        <avgScoreLabelBarMarks label="Label voor gemiddelde score per blok" type="TextInput" language="true"/>
        <groupUserLabel label="Term voor een deelnemer van een blok" type="TextInput" language="true"/>
        <groupScore label="Term beschrijving score van een blok" type="TextInput" language="true"/>
        <userScore label="Term voor beschrijving score deelnemer" type="TextInput" language="true"/>
        <insufficientDataText label="Tekst onvoldoende data" type="TextInput" wysiwyg="true" language="true"/>
        <notWorkingInDashboardMode label="Werkt niet in dashboard modus tekst" type="TextInput" wysiwyg="true" language="true"/>

        <avgAllLabelText label="Label gemiddelde diagram" type="TextInput" wysiwyg="true" language="true"/>
        <personalLabelText label="Label persoonlijk diagram" type="TextInput" wysiwyg="true" language="true"/>
        <personalAvgLabelText label="Label persoonlijk gemiddelde diagram" type="TextInput" wysiwyg="true" language="true"/>
        <groupAverageLabelText label="Label groep gemiddelde grafiek" type="TextInput" wysiwyg="true" language="true" mandatory="true" defaultValue="Groep gemiddelde"/>

        <!--
        <opinionOptions type="group" label="'Opinion 2D' extra options" condition="interactionType=='opinion'&amp;&amp;opinionClass!=''" optional="true" tooltip="Extra options that only make sense if the interaction type is 'Opinion 2D'">
            <colour label="Personal graph" type="colourPicker" defaultValue="0xFF0000" optional="true"/>
            <colourPersonalAvg label="Personal average graph" type="colourPicker" defaultValue="0x0000FF" optional="true"/>
            <colourAvg label="Average graph" type="colourPicker" defaultValue="0x00FF00" optional="true"/>
            <labelFontSize label="Font size of the labels" type="NumericStepper" min="4" max="100" step="1" defaultValue="12" optional="true" />
        </opinionOptions>
        -->
        <openAnswerOptions type="group" label="Open antwoord extra opties" condition="interactionType=='open'" optional="true" tooltip="Optionele eigenschappen die alleen zin hebben bij het interactietype 'Open antwoord'">
            <showUserID label="Toon id gebruiker" type="checkbox" defaultValue="false" optional="true" tooltip="Toon de gebruikers id's bij ieder open antwoord indien die informatie aanwezig is"/>
            <showDate label="Toon datum" type="checkbox" defaultValue="false" optional="true" tooltip="Toon inleverdatum"/>
            <sortOrder label="Sorteer volgorde" type="combobox" defaultValue="decreasing" data="increasing,decreasing" options="Oudste eerst,Nieuwste eerst" optional="true" tooltip="Sorteer de volgorde van de antwoorden"/>
        </openAnswerOptions>
        <myOpenAnswerText label="Mijn open antwoorden tekst" type="TextInput" wysiwyg="true" language="true"/>
        <allOpenAnswerText label="Alle open antwoorden tekst" type="TextInput" wysiwyg="true" language="true"/>
        <group type="group" label="Filteren" optional="true">
             <groupFromUrl label="Filter groep op URL" type="checkbox" defaultValue="false" optional="true" tooltip="Filter op groepnaam, daar waar de groepnaam uit de URL voortkomt (groep=groepnaam)"/>
             <groupName label="Filter groepnaam" type="TextInput" defaultValue="" wysiwyg="false" optional="true" tooltip="Filter op groepnaam, gebruik deze groepnaam, als de groep niet gespecificeerd is in de URL (groep=groepnaam). Je moet het filteren op groep vanuit de url ook aanzetten."/>
             <contextFilter label="Filter op LTI context" type="checkbox" defaultValue="false" optional="true" tooltip="Filter op LTI context, wanneer de  LTI context uit de LTI launch of de URL (lti_context_id=id) wordt gehaald"/>
             <contextUsersFilter label="Filter op LTI 1.3 deelnemers" type="checkbox" defaultValue="false" optional="true" tooltip="Filter op huidige LTI 1.3 deelnemer(s)."/>
        </group>

      <newNodes>
          <interactionBlock><![CDATA[<interactionBlock adaptiveContent="" conScoreBetween="0,100" conScoreAnswer="Label antwoord " conScoreGrouping=""/>]]></interactionBlock>
        </newNodes>
    </interaction><interactionBlock menuItem="Interactie blok">
          <adaptiveContent label="Tekst" type="TextArea" wysiwyg="true" height="360" placeholder="Plaats de adaptieve content hier"/>
          <blockName label="Naam staaf" type="TextInput" defaultValue="" wysiwyg="false" optional="true" condition="parent.interactionType=='score'||(parent.interactionType=='opinion' &amp;&amp; parent.opinionClass!=null)||parent.interactionType=='grouping'"/>
          <conScoreBetween label="Score tussen" type="TextInput" mandatory="true" defaultValue="0,100" condition="parent.interactionType=='score'||(parent.interactionType=='opinion' &amp;&amp; parent.opinionClass!=null)||parent.interactionType=='grouping'" wysiwyg="false"/>
          <conScoreAnswer label="Antwoordlabel is gelijk aan" type="TextInput" mandatory="true" defaultValue="Label antwoord" condition="parent.interactionType=='answer'" wysiwyg="false"/>
          <blockColor label="Kleur balk" type="colourPicker" defaultValue="" optional="true" condition="parent.interactionType=='score'||(parent.interactionType=='opinion' &amp;&amp; parent.opinionClass!=null)||parent.interactionType=='grouping'"/>
    </interactionBlock><annotatedDiagram menu="Interactiviteit" menuItem="Geannoteerde hotspot" hint="Interactie onderzoeken geannoteerde hotspot" icon="icPageWhiteStar" remove="true" thumb="thumbs/annotatedDiagram.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#geannoteerdehotspot" wiki="https://xerte.org.uk/wiki/doku.php?id=interactivity_annotated_diagram" deepLink="true">

    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
    <text label="Pagina tekst" type="TextArea" height="250" placeholder="Voeg paginatekst toe"/>
	<align label="Uitlijnen" type="ComboBox" options="Links,Rechts,Boven" data="Left,Right,Top" defaultValue="Left" width="100"/>

	<image type="group" label="Afbeelding">
		<url label="Bestand" type="media" placeholder="Selecteer afbeelding"/>
		<tip label="Omschrijving" type="TextInput" placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
		<panelWidth label="Grootte" options="Klein,Medium,Groot" type="ComboBox" data="Small,Medium,Large" defaultValue="Medium" mandatory="true" width="100"/>
	</image>
	
	<hs type="group" label="Markeer">
		<shape label="Type" type="ComboBox" options="Lijn,Ovaal,Rechthoek,Pijl" data="None,Oval,Rectangle,Arrow" defaultValue="Rectangle" width="120"/>
		<colour label="Kleur" type="ColourPicker" defaultValue="0xFFFF00"/>
	</hs>

	<link label="Verberg lijst" type="Checkbox" optional="true" defaultValue="false" tooltip="Toon of verberg de lijst"/>

	<movieSize label="Video grootte (b,h)" type="textInput" defaultValue="320,240" optional="true" deprecated="Deze optie wordt niet meer gebruikt in deze XOT versie"/>

    <newNodes>
      <hotspotGroup><![CDATA[<hotspotGroup name="Voeg hotspotgroep titel toe" text=""/>]]></hotspotGroup>
	  <flexhotspot><![CDATA[<flexhotspot name="Voeg titel hotspot toe" text="" x="0" y="0" w="100" h="100"/>]]></flexhotspot>
    </newNodes>
	
  <resources label="Bronnen bestanden / links" type="DataGrid" gridTxt="&lt;p&gt;Bronnen kunnen URL's, ge&#xFC;ploade bestanden of andere pagina's binnen deze pagina of leerobject zijn.&lt;br /&gt;Voer een URL in, upload een bestand naar het bronveld of selecteer een pagina in het dropdownmenu 'Xerte-paginalink'.&lt;/p&gt;" columns="4" colWidths="20,15,15,50" editable="1,1,1,1" cellType="textInput,media,pageList,textArea" wysiwyg="false,false,false,true" controls="1" headers="Titel,Bron,Xerte Pagina Link,Beschrijving" newRow=",,," defaultValue="|" optional="true" tooltip="Een lijst met aanvullende bronnen met betrekking tot de pagina-inhoud" common="true"/><narrate type="group" label="Audio" optional="true" tooltip="Voeg een audio player toe aan de onderkant van de pagina" common="true">
		<narration label="Audio bestand" type="media" defaultValue="Selecteer een audiobestand" placeholder="Selecteer een audio bestand" optional="true"/>
		<narrationTranscript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er wordt een transcriptknop toegevoegd aan de audiobalk wanneer transcripttekst is opgenomen"/>    
		<playNarration label="Auto-Play" type="CheckBox" defaultValue="false" optional="true" tooltip="Speel automatisch af wanneer de pagina wordt bekeken. NB.: sommige browsers staan automatisch afspelen niet toe"/>
		<narrationNavigate label="Navigeer aan het einde" type="CheckBox" defaultValue="false" optional="true" tooltip="Ga automatisch naar de volgende pagina wanneer de audio afgelopen is"/>
	</narrate><navSetting label="Navigatie knoppen" options="Alle,Vorige en volgende,Alleen terug,Alleen volgende,Geen" type="ComboBox" width="120" data="all,backnext,backonly,nextonly,none" defaultValue="all" optional="true" deprecated="Deze optie wordt niet meer gebruikt in deze XOT versie. Gebruik de nieuwe groep Navigatie knoppen (optionele eigenschap) om deze in te stellen." common="true"/><navBtns type="group" label="Navigatie knoppen" optional="true" tooltip="Schakel de individuele navigatieknoppen op deze pagina uit" info="Het standaard beschikbaar hebben van alle navigatie knoppen op iedere pagina hangt af van de navigatie instelling van het leerobject. Deactiveer knoppen op de individuele pagina's door deze te selecteren op die pagina." common="true">
		<home label="Home / Menu knop" type="CheckBox" defaultValue="true" optional="true"/>
		<back label="Terug / Vorige knop" type="CheckBox" defaultValue="true" optional="true"/>
		<next label="Volgende knop" type="CheckBox" defaultValue="true" optional="true"/>
		<save label="Sessie opslaan knop" type="CheckBox" defaultValue="true" optional="true"/>
	</navBtns><hideShow type="group" label="Verberg/Toon pagina" optional="true" tooltip="GEEF EEN BESCHRIJVING HIER..." info="Je kunt deze pagina altijd verbergen door de velden 'Van' en 'Tot' leeg te laten. Je kunt ook een datum (en eventueel een tijd) opgeven in de velden 'Van' en 'Tot' om aan te geven wanneer de pagina beschikbaar moet zijn." common="true">
		<hidePage label="Verberg pagina" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideOnTime label="Van (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideOnDate!=''&amp;&amp;hideOnDate!=undefined"/>
		<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideUntilTime label="Tot (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideUntilDate!=''&amp;&amp;hideUntilDate!=undefined"/>
	</hideShow><linkGroup type="group" label="Stand-alone pagina" optional="true" tooltip="Verwijder pagina van menu zodat je alleen via Xertelinks toegang hebt." common="true">
