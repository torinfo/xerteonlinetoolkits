	<alttext label="Tooltip beschrijving" type="script" height="100" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)." optional="true"/>
  </QHotSpot><hotspotImage menu="Interactiviteit" menuItem="Hotspot afbeelding" hint="Een interactie waarbij gebieden op een afbeelding gemarkeerd worden gecombineerd met een tekstuele uitleg per gebied. Het type interactiviteit kan gevarieerd worden.&lt;br&gt;" icon="icHotspot" thumb="thumbs/hotspotImage.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#hotspotafbeelding" wiki="https://xerte.org.uk/wiki/doku.php?id=interactivity_hotspot_image_page" remove="true">

    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
    <text label="Pagina tekst" type="TextArea" height="250" placeholder="Voeg paginatekst toe"/>
