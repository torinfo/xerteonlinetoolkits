	<submitText label="Label inleverknop voor koppelen" type="TextInput" wysiwyg="true" language="true"/>
    <incomplete label="Niet compleet" type="TextInput" wysiwyg="true" language="true"/>
	
	<imgWidth label="Afbeelding breedte" options="Klein,Medium,Groot" type="ComboBox" data="Small,Medium,Large" defaultValue="Medium" optional="true"/>
	
	<labelPos label="Label Positie" type="ComboBox" data="image,text" options="Onder afbeelding,Onder tekst" defaultValue="image" optional="true"/>

	<trackingWeight label="Tracking score weging" optional="true" type="textInput" width="120" defaultValue="1.0" tooltip="Pas de weging van de opdracht op deze pagina aan, ten opzichte van andere gescoorde pagina's in het leerobject. Als je de weging instelt op 0, betekent dit dat de opdracht op deze pagina niet meetelt de totaalscore van het leerobject."/>
	
