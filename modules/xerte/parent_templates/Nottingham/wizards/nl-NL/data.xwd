    <controls label="Interactiviteit" options="Afspeelbalk,Oorspronkelijke SWF" type="ComboBox" data="Control Bar,Native SWF" defaultValue="Control Bar" width="100" optional="true" flashonly="true" deprecated="Onbekend hoe dit gebruikt wordt"/>
