	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></bullets><buttonNav deprecated="Deze pagina is niet meer in gebruik maar blijft wel gewoon werken in dit leerobject. De multi-navigator pagina kan gebruikt worden om een nieuwe knop navigator te maken." deprecatedLevel="laag" menu="Navigatoren" menuItem="Navigatie knop" hint="Presenteert een serie van pagina's met tekst en afbeeldingen met navigatie met behulp van een navigatiebalk." icon="icButtonBar" remove="true" thumb="thumbs/butNav.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#knopnavigator" deepLink="true">
    <name label="Pagina titel" type="TextInput" wysiwyg="true" placeholder="Voeg paginatitel toe"/>
