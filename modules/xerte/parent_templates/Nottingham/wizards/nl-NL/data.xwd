		<run label="Uitvoeren" options="Alleen de eerste keer dat de pagina wordt bekeken,Iedere keer dat de pagina wordt bekeken" type="ComboBox" width="120" data="first,all" defaultValue="first" optional="true"/>
	</scripts><background type="group" label="Achtergrond" optional="true" tooltip="Voeg een achtergrondafbeelding toe aan deze pagina. Dit overschrijft elke achtergrondafbeelding die op leerobjectniveau is toegevoegd." common="true">
		<bgImage label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<backgroundFit optional="true" type="ComboBox" options="Uitrekken om te passen,Bijsnijden om te passen,Hele afbeelding tonen" data="fill,cover,contain" defaultValue="cover" label="Afbeelding schaal" tooltip="Hoe de achtergrondafbeelding de beschikbare ruimte vult. 'Uitrekken om te passen' zal de afbeelding verticaal of horizontaal uitrekken om de ruimte te vullen, 'Bijsnijden om te passen' zal de afbeelding bijsnijden om te passen zonder deze te vervormen en 'Hele afbeelding weergeven' zal de volledige geschaalde afbeelding weergeven zonder deze te vervormen. Let op: dit heeft geen effect in Internet Explorer."/>
		<bgImageAlpha label="Doorzichtigheid" type="NumericStepper" min="0" max="100" step="10" defaultValue="30" optional="true" tooltip="De dekking van de afbeelding, waarbij 0 volledig transparant is en 100 helemaal niet transparant is."/>
		<bgImageDark optional="true" type="NumericStepper" min="0" max="100" step="1" defaultValue="0" label="Donkerheid" tooltip="Voeg een filter toe om de afbeelding donkerder te maken. 0 is niet donker en 100 is volledig donker (zwart)."/>
		<bgImageGrey optional="true" type="CheckBox" label="Grijsschaal" defaultValue="false" tooltip="Voeg een filter toe om de kleur van de afbeelding te veranderen naar een grijsschaal."/>
	</background><pageTimer type="group" label="Pagina timer" optional="true" tooltip="Voeg een timer toe aan de pagina, tel terug naar 0" common="true">
		<showTimer label="Toon timer" optional="true" type="CheckBox" defaultValue="true" conditionTrigger="true"/>
		<timer label="Toon limiet (seconden)" defaultValue="60" type="NumericStepper" min="0" step="1" width="100" condition="showTimer=='true'" optional="true"/>
		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
