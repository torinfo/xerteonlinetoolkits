    <type label="Vraagtype" options="Enkel antwoord,Meerdere antwoorden" type="ComboBox" data="Single Answer,Multiple Answer" defaultValue="Single Answer" width="120"/>
    <questionFeedback label="Toon feedback vraag" options="Nee,Ja" type="ComboBox" data="no,yes" defaultValue="no" width="120"/>

	<imgInfo type="group" label="Afbeelding" optional="true">
