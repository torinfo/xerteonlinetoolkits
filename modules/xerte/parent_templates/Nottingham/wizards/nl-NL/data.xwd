	</hsAppearance>

	<zoomInTxt label="Zoom in" type="TextInput" wysiwyg="true" language="true"/>
	<zoomOutTxt label="Zoom uit" type="TextInput" wysiwyg="true" language="true"/>
	<fullScreenTxt label="Volledig scherm" type="TextInput" wysiwyg="true" language="true"/>
	<sceneMenuTxt label="Scene menu" type="TextInput" wysiwyg="true" language="true" defaultValue="Scene menu" mandatory="true"/>
	<lockLabel label="Label wachtwoord" type="TextInput" wysiwyg="true" language="true"/>
	<lockSubmit label="Voer wachtwoord in" type="TextInput" wysiwyg="true" language="true"/>
	<lockPswdWrong label="Onjuist wachtwoord" type="TextInput" wysiwyg="true" language="true"/>
	
