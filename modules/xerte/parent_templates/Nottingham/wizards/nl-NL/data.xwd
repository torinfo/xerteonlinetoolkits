  </image><quiz menu="Interactiviteit" menuItem="Quiz" icon="icPageWhiteGear" remove="true" thumb="thumbs/quiz.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#quiz" wiki="https://xerte.org.uk/wiki/doku.php?id=interactivity_quiz_page" hint="De quiz is een reeks van multiple choice vragen met enkele of meerdere antwoordmogelijkheden op de vraag.">
    <name label="Titel quiz" type="TextInput" wysiwyg="true"/>
	<order label="Volgorde vragen" options="Volgorde,Willekeurig" type="comboBox" data="sequence,random" defaultValue="random" width="120"/>
