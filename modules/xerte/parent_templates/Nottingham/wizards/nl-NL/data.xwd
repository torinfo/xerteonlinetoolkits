    <restrict label="Beperk gissingen" type="Combobox" options="Letters,Letters en cijfers,Alle tekens toestaan" data="letter,letterNumber,all" defaultValue="all" mandatory="true" tooltip="Gebruik deze optie om de tekens te beperken die als gissingen kunnen worden gebruikt."/>
    
