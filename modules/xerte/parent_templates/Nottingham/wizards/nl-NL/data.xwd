	<feedbackGroup type="group" label="Feedback" optional="true">
    	<feedback type="TextArea" height="40" label="Algemene feedback" optional="true" tooltip="Feedback die wordt weergegeven wanneer een antwoord is gegeven. Kan worden gebruikt in combinatie met feedback op maat voor elke antwoordoptie."/>
    	<markFeedback label="Beoordeel" type="CheckBox" defaultValue="true" optional="true" tooltip="Markeer het antwoord als juist of onjuist in het feedbackblok (er moet ook minstens &#xE9;&#xE9;n antwoordoptie als correct worden ingesteld om dit te laten zien)"/>
    	<feedbackPos label="Feedback volgorde" options="Algemeen &amp;gt; Antwoord &amp;gt; Juist/Onjuist,Algemeen &amp;gt; Juist/Onjuist &amp;gt; Antwoord,Antwoord &amp;gt; Juist/Onjuist &amp;gt; Algemeen,Antwoord &amp;gt; Algemeen &amp;gt; Juist/Onjuist,Juist/Onjuist &amp;gt; Algemeen &amp;gt; Antwoord,Juist/Onjuist &amp;gt; Antwoord &amp;gt; Algemeen" type="ComboBox" data="GAC,GCA,ACG,AGC,CGA,CAG" defaultValue="GAC" width="120" optional="true" tooltip="De volgorde van de verschillende soorten feedback wordt getoond in het feedbackveld. De standaardvolgorde is Algemene feedback&amp;gt; Feedback antwoorden&amp;gt; Juiste / Onjuist"/>
    </feedbackGroup>
	
	<imgInfo type="group" label="Afbeelding" optional="true">
		<image label="Afbeelding" type="Media" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding" optional="true"/>
		<tip label="Beschrijving afbeelding" type="TextInput" optional="true" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)."/>
		<caption label="Onderschrift" type="textInput" optional="true" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
	</imgInfo>
	
	<soundGroup type="group" label="Audio" optional="true" tooltip="Voeg een audiospeler toe onder de vraag">
		<sound label="Bestand" type="media" defaultValue="" placeholder="Selecteer een audio bestand" optional="true"/>
		<soundTranscript label="Transcript" type="textArea" height="100" defaultValue="" optional="true" tooltip="Er verschijnt een transcriptieknop bij de audiospeler wanneer hier tekst wordt toegevoegd"/>
	</soundGroup>
	
