	</navBtns><hideShow type="group" label="Verberg/Toon pagina" optional="true" tooltip="GEEF EEN BESCHRIJVING HIER..." info="Je kunt deze pagina altijd verbergen door de velden 'Van' en 'Tot' leeg te laten. Je kunt ook een datum (en eventueel een tijd) opgeven in de velden 'Van' en 'Tot' om aan te geven wanneer de pagina beschikbaar moet zijn." common="true">
		<hidePage label="Verberg pagina" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<hideOnDate label="Van" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideOnTime label="Van (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideOnDate!=''&amp;&amp;hideOnDate!=undefined"/>
		<hideUntilDate label="Tot" type="DateField" defaultValue="" optional="true" allowBlank="true" condition="hidePage=='true'" conditionTrigger="true" preventPrev="true" tooltip="Gebruik de kalender om een datum te selecteren (formaat JJJJ-MM-DD)"/>
		<hideUntilTime label="Tot (uu:mm)" type="TextInput" defaultValue="0:00" optional="true" condition="hidePage=='true'&amp;&amp;hideUntilDate!=''&amp;&amp;hideUntilDate!=undefined"/>
	</hideShow><linkGroup type="group" label="Stand-alone pagina" optional="true" tooltip="Verwijder pagina van menu zodat je alleen via Xertelinks toegang hebt." common="true">
		<linkPage label="Stand-alone" type="CheckBox" defaultValue="true" conditionTrigger="true" optional="true"/>
		<linkTarget label="Open in" type="ComboBox" data="same,new,lightbox" options="Zelfde venster,Nieuw venster,Lightbox" defaultValue="lightbox" condition="linkPage=='true'" optional="true" tooltip="Geeft aan hoe de link naar deze pagina wordt geopend"/>
		<headerHide label="Verberg header" type="Checkbox" defaultValue="false" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de headerbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bijvoorbeeld bekijkt in een lightbox."/>
		<footerHide label="Verberg Voetbalk" type="CheckBox" defaultValue="true" condition="linkPage=='true'" optional="true" tooltip="Wanneer aangevinkt, zal de voetbalk verborgen zijn wanneer je deze pagina bekijkt. Dit kan wenselijk zijn wanneer je de pagina bekijkt in een lightbox."/>
		<reqProgress label="Opnemen in de voortgangbalk" type="CheckBox" defaultValue="false" condition="linkPage=='true'&amp;&amp;(treeroot.progressBar!=undefined||treeroot.progressBarType=='true'||((treeroot.progressBarType=='header1'||treeroot.progressBarType=='header2'||treeroot.progressBarType=='header3')&amp;&amp;treeroot.progressSub=='false'))" optional="true" tooltip="Standaard worden stand-alone pagina's uitgesloten van het voltooiings percentage op de voortgangsbalk. Vink deze optie aan om deze pagina wel op te nemen in de voortgang van het leerobject."/>
	</linkGroup><passwordGroup type="group" label="Toegangscode" optional="true" tooltip="De toegang tot deze pagina is beperkt totdat een toegangscode wordt ingevoerd. Let op: om het leerobject veilig te beschermen, moet je de beveiliging regelen via het tabblad Toegang in de leerobject eigenschappen in plaats van deze optionele eigenschap te gebruiken. Deze functie is vooral bedoeld voor het ontsluiten van nieuw materiaal en niet voor beveiliging volgens de AVG." common="true">
		<password label="Toegangscode(s)" type="TextInput" optional="true" defaultValue="" tooltip="Een komma gescheiden lijst met toegangscodes die toegang geven tot deze site"/>
		<passwordCase label="Hoofdletter gevoelig" type="CheckBox" optional="true" defaultValue="true" tooltip="De toegangscodes zijn hoofdletter gevoelig wanneer deze optie is aangevinkt"/>
		<passwordType label="Type" type="ComboBox" data="standard,centered,vault,vaultnumeric" options="Standaard,Standaard midden,Kluis,Toetsenbord" optional="true" defaultValue="standard" tooltip="Pas het uiterlijk van de toegangscode-informatie op de pagina aan. De toegangscode moet numeriek zijn wanneer 'Toetsenbord' wordt gebruikt."/>
		<passwordInfo label="Instructies" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Enter an access code below to view the page:&lt;/p&gt;" tooltip="De instructies die verschijnen in het toegangscode venster"/>
		<passwordError label="Foutmelding" type="TextArea" height="50" optional="true" defaultValue="&lt;p&gt;Invalid access code&lt;/p&gt;" tooltip="De foutmelding die verschijnt wanneer de verkeerde toegangscode wordt gebruikt"/>
		<passwordSubmit label="Label knop" type="TextInput" optional="true" defaultValue="Controleer" tooltip="Het label van de vul toegangscode in knop"/>
	</passwordGroup><introGroup type="group" label="Introductie" optional="true" tooltip="Voeg een Pagina-introductie knop toe aan de voetbalk die informatie in een lightbox opent, wanneer erop wordt geklikt. Deze introductie kan worden ingesteld om automatisch te openen wanneer de pagina voor het eerst wordt geladen." common="true">
		<introType type="ComboBox" label="Content type" defaultValue="text" options="Tekst,Afbeelding,Video,URL,Bestand" data="text,image,video,url,file" conditionTrigger="true" optional="true" tooltip="Het type inhoud dat wordt gebruikt als introductie voor deze pagina"/>
		<pageIntro label="Tekst" type="TextArea" height="100" defaultValue="" condition="introType=='text'||introType==undefined" optional="true"/>
		<introImg label="Afbeelding" type="media" height="100" defaultValue="" condition="introType=='image'" optional="true" placeholder="Selecteer afbeelding"/>
		<introVideo label="Video" type="media" height="100" defaultValue="" condition="introType=='video'" optional="true" placeholder="Selecteer een videobestand of voer een url/embedcode in"/>
		<introTip label="Omschrijving" type="TextInput" defaultValue="Voer een beschrijving in voor toegankelijkheid (accessibility)." placeholder="Voer een beschrijving in voor toegankelijkheid (accessibility)." condition="introType=='image'||introType=='video'" optional="true"/>
		<introCaption label="Onderschrift" type="TextInput" defaultValue="" wysiwyg="true" placeholder="Voeg tekst onderschrift toe" condition="introType=='image'" optional="true" tooltip="Optie: voeg onderschrift toe onder de afbeelding"/>
		<introURL label="URL" type="TextInput" defaultValue="" condition="introType=='url'" optional="true" placeholder="Voeg een URL toe"/>
		<introFile label="Bestand" type="media" height="100" defaultValue="" condition="introType=='file'" optional="true" placeholder="Selecteer een bestand (bijvoorbeeld een PDF)"/>
		<introTitle type="CheckBox" label="Weergeven titel" defaultValue="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Toon de paginatitel boven de introductietekst"/>
		<introBtn type="CheckBox" label="Start knop" defaultValue="true" conditionTrigger="true" condition="introType=='text'||introType==undefined||introType=='image'" optional="true" tooltip="Voeg een 'start'-knop toe onder de introductietekst die de lightbox sluit wanneer erop wordt geklikt"/>
		<introBtnTxt label="Tekst knop" type="TextInput" defaultValue="Start" condition="introBtn=='true'&amp;&amp;(introType=='text'||introType==undefined||introType=='image')" wysiwyg="true" optional="true"/>
		<introWidth label="Breedte lightbox" options="Auto,Klein,Medium,Groot,Volledig" type="ComboBox" data="Auto,Small,Medium,Large,Full" defaultValue="Auto" condition="introType=='text'||introType==undefined" optional="true"/>
		<introShow type="ComboBox" label="Open automatisch" defaultValue="first" options="Elke keer dat deze pagina wordt bekeken,De eerste keer dat deze pagina wordt bekeken,Nooit" data="always,first,never" optional="true" tooltip="Geef op of de introductie automatisch wordt geopend wanneer de pagina wordt bekeken"/>
	</introGroup><customLinkGroup type="group" label="Pagina ID" optional="true" tooltip="Maak een aangepaste URL voor deze pagina" info="&lt;p&gt;Maak een directe link naar deze pagina door #jePaginaID toe te voegen aan het einde van de project-URL.&lt;br /&gt;Vermijd het gebruik van spaties, speciale tekens en het woord 'page' in ID's en zorg ervoor dat elke ID uniek is binnen het hele project.&lt;br /&gt;ID's zijn hoofdlettergevoelig.&lt;/p&gt;" common="true">
		<pageID label="Pagina ID" type="TextInput" optional="true"/>
	</customLinkGroup><unmarkForCompletion label="Voltooiing niet verplicht" type="CheckBox" defaultValue="true" tooltip="Wanneer het leerobject wordt getrackt (bijvoorbeeld met behulp van SCORM of xAPI), selecteer 'afronding niet verplicht' wanneer de pagina niet voltooid hoeft te worden, zodat het leerobject als voltooid kan worden gemarkeerd." optional="true" common="true"/><disableGlossary label="Woordenlijst uitzetten" defaultValue="true" type="CheckBox" condition="treeroot.glossary!=undefined" optional="true" tooltip="Voorkom dat woorden uit de woordenlijst op deze pagina worden getoond" common="true"/><styles label="Stijl" type="script" height="200" optional="true" tooltip="Voeg op maat gemaakte CSS toe aan deze pagina" common="true"/><tracking type="group" label="Tracking" optional="true" tooltip="Eigenschappen met betrekking tot tracked leerobjecten (bijvoorbeeld SCORM or xAPI)" common="true">
        <trackinglabel label="Trackinglabel" type="TextInput" wysiwyg="false" optional="true" tooltip="In plaats van paginanummer het label als tracking identifier gebruiken (SCORM en xAPI)"/>
        <grouping label="Track groepering" type="Grouping" optional="true" tooltip="Label voor groepering van xAPI events, om te gebruiken voor groepering in xAPI rapporten"/>
	</tracking><scripts type="group" label="Script" optional="true" tooltip="Voeg JavaScript toe die bij de eerste keer dat deze pagina geladen wordt of iedere keer dat deze pagina geladen wordt, wordt uitgevoerd " common="true">
		<script label="Script" type="script" height="200" defaultValue="// JavaScript / jQuery" optional="true"/>
		<run label="Uitvoeren" options="Alleen de eerste keer dat de pagina wordt bekeken,Iedere keer dat de pagina wordt bekeken" type="ComboBox" width="120" data="first,all" defaultValue="first" optional="true"/>
	</scripts><background type="group" label="Achtergrond" optional="true" tooltip="Voeg een achtergrondafbeelding toe aan deze pagina. Dit overschrijft elke achtergrondafbeelding die op leerobjectniveau is toegevoegd." common="true">
		<bgImage label="Afbeelding" type="media" optional="true" defaultValue="Selecteer een afbeelding" placeholder="Selecteer afbeelding"/>
		<backgroundFit optional="true" type="ComboBox" options="Uitrekken om te passen,Bijsnijden om te passen,Hele afbeelding tonen" data="fill,cover,contain" defaultValue="cover" label="Afbeelding schaal" tooltip="Hoe de achtergrondafbeelding de beschikbare ruimte vult. 'Uitrekken om te passen' zal de afbeelding verticaal of horizontaal uitrekken om de ruimte te vullen, 'Bijsnijden om te passen' zal de afbeelding bijsnijden om te passen zonder deze te vervormen en 'Hele afbeelding weergeven' zal de volledige geschaalde afbeelding weergeven zonder deze te vervormen. Let op: dit heeft geen effect in Internet Explorer."/>
		<bgImageAlpha label="Doorzichtigheid" type="NumericStepper" min="0" max="100" step="10" defaultValue="30" optional="true" tooltip="De dekking van de afbeelding, waarbij 0 volledig transparant is en 100 helemaal niet transparant is."/>
		<bgImageDark optional="true" type="NumericStepper" min="0" max="100" step="1" defaultValue="0" label="Donkerheid" tooltip="Voeg een filter toe om de afbeelding donkerder te maken. 0 is niet donker en 100 is volledig donker (zwart)."/>
		<bgImageGrey optional="true" type="CheckBox" label="Grijsschaal" defaultValue="false" tooltip="Voeg een filter toe om de kleur van de afbeelding te veranderen naar een grijsschaal."/>
	</background><pageTimer type="group" label="Pagina timer" optional="true" tooltip="Voeg een timer toe aan de pagina, tel terug naar 0" common="true">
		<showTimer label="Toon timer" optional="true" type="CheckBox" defaultValue="true" conditionTrigger="true"/>
		<timer label="Toon limiet (seconden)" defaultValue="60" type="NumericStepper" min="0" step="1" width="100" condition="showTimer=='true'" optional="true"/>
		<timerLabel label="Tijd is op tekst" type="TextInput" optional="true" defaultValue="Tijd is op" condition="showTimer=='true'"/>
		<timerText label="Label timer" type="TextInput" optional="true" defaultValue="Beschikbare tijd" condition="showTimer=='true'"/>
	</pageTimer><notes label="Notitie" type="TextArea" height="150" defaultValue="" optional="true" tooltip="Hier kan een notitie voor deze pagina toegevoegd worden. Deze zijn priv&#xE9; en niet zichtbaar voor de gebruiker." common="true"/><variables type="group" label="Variabelen" condition="treeroot.variables!=undefined" optional="true" tooltip="Gebruik in combinatie met de optionele eigenschap 'Variabelen' op leerobjectniveau" common="true">
		<varConfirm label="Verzendbericht" type="TextInput" condition="treeroot.variables!=undefined" defaultValue="Bedankt voor het verzenden van jouw antwoorden" optional="true" tooltip="Bericht dat wordt weergegeven nadat nieuwe variabelenwaarden zijn opgegeven door de eindgebruiker"/>
		<varUpdate label="Update variabelen" type="CheckBox" condition="treeroot.variables!=undefined" defaultValue="true" optional="true" tooltip="Update de variabelen op deze pagina nadat nieuwe variabelen zijn toegevoegd door de eindgebruiker"/>
	</variables><lightboxGroup type="group" label="Lightbox" optional="true" tooltip="Standaard worden aangeklikte afbeeldingen geopend in een lightbox. Gebruik deze eigenschappen om de lightbox-functionaliteit alleen voor deze pagina in / uit te schakelen" common="true">
		<lightbox type="CheckBox" label="Lightbox afbeeldingen" defaultValue="true" conditionTrigger="true" optional="true"/>
		<lightboxCaption type="ComboBox" label="Onderschrift" defaultValue="false" condition="lightbox=='true'" optional="true" options="Geen,Onder afbeelding,Boven afbeelding" data="false,below,above" tooltip="Voeg een onderschrift toe aan lightbox-afbeeldingen op deze pagina. De onderschrifttekst is afkomstig uit de velden 'Beschrijving' of 'Alt-tekst'."/>
	</lightboxGroup><pageHeaderGroup type="group" label="Kleuren header" optional="true" tooltip="Wijzig de achtergrondkleur van de hearder en/of de kleur van de titels voor deze pagina." common="true">
		<headerBgColor type="ColourPicker" label="Header achtergrondkleur" defaultValue="" optional="true" tooltip="Hierdoor wordt de achtergrondkleur van de header alleen voor deze pagina gewijzigd. Denk eraan om indien nodig ook de kleur van de titels te wijzigen om het juiste contrast voor toegankelijkheid te behouden."/>
		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></interactiveVideo><ivMediaPanel menuItem="Video paneel" icon="icFilm" remove="false" duplicate="false">

