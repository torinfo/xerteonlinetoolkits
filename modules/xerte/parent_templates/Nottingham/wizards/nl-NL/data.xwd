    <failedFindTxt label="Niet alle selecties zijn juist" type="TextInput" wysiwyg="true" language="true"/>
	<passedQuestionTxt label="Je hebt deze opdracht goed beantwoord" type="TextInput" wysiwyg="true" language="true"/>
