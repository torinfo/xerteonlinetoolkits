  </mcqStep><mcqStepOption icon="icBullet" remove="true" duplicate="true" menuItem="Antwoord">
	<name label="Antwoord optie" type="TextInput" wysiwyg="true"/>
	<target label="Doel ID" type="TextInput" optional="true" deprecated="Deze eigenschap is verouderd. Gebruik het drop-down menu Doel-ID om in plaats daarvan de doelstap te selecteren. De ID die in dit veld is ingevoerd, blijft werken totdat het drop-down menu wordt gebruikt."/>
	<targetNew label="Doel ID" type="pageList" listTarget="1" defaultValue="" mandatory="true"/>
	<resultTxt label="Opgeslagen resultaat tekst" type="TextArea" height="100" optional="true" tooltip="Slaat tekst gerelateerd aan dit antwoord toe om bij de reslutaten te gebruiken. Deze tekst verschijnt alleen bij de reslutaten als 'Samenvoegen opgeslagen resultaten' (optionele eigenschap) is toegevoegd."/>
	<displayTxt label="Tekst voortgang" type="TextArea" height="100" optional="true" tooltip="Voegt extra tekst to aan de Intro tekst. Alle voortgangsteksten blijven zichtbaar tijdens de vervolgstappen tot de 'Verwijder voortgangs tekst' (optionele eigenschap) wordt gebruikt."/>
	<clear label="Verwijder tekst voortgang" type="CheckBox" optional="true" tooltip="Verwijderd alle voortgangsteksten die in vorige stappen zijn toegevoegd."/>
	
	<info><![CDATA[Zorg ervoor dat de Doel ID overeenkomt met de Unieke ID van de vraag, resultaat of informatie stap.]]></info>
  </mcqStepOption><sliderStep icon="icComment" remove="true" duplicate="true" menuItem="Schuifbalk">
	<name label="Unieke ID" type="TextInput"/>
	<text label="Vraag" type="TextArea" height="100" placeholder="Voeg een vraag toe"/>
	<unit label="Eenheid van het antwoord" type="TextInput" wysiwyg="true"/>
	<min label="Minimum waarde" type="TextInput"/>
	<max label="Maximum waarde" type="TextInput"/>
	<step label="Toename" type="TextInput"/>
	<value label="Oorspronkelijke waarde" type="TextInput"/>
	<helpTxt label="Meer informatie" type="TextArea" height="100" optional="true" tooltip="Geeft toegang to extra informatie via een knop en een popup tekst."/>
	<unitPos label="Positie eenheid" type="ComboBox" options="Start,Einde" data="start,end" defaultValue="end" width="100" optional="true" tooltip="Moet de eenheid van het antwoord voor (&#x20AC;10) of na (10%) het getal worden geplaatst?"/>
	<displayTxt label="Tekst voortgang" type="TextArea" height="100" optional="true" tooltip="Voegt extra tekst to aan de Intro tekst. Alle voortgangsteksten blijven zichtbaar tijdens de vervolgstappen tot de 'Verwijder voortgangs tekst' (optionele eigenschap) wordt gebruikt."/>
	<clear label="Verwijder tekst voortgang" type="CheckBox" optional="true" tooltip="Verwijderd alle voortgangsteksten die in vorige stappen zijn toegevoegd."/>
	
	<newNodes>
		<sliderStepOption><![CDATA[<sliderStepOption min="0" max="1" targetNew=""/>]]></sliderStepOption>
	</newNodes>
	
  </sliderStep><sliderStepOption icon="icBullet" remove="true" duplicate="true" menuItem="Antwoord">
	<min label="Minimum bereik" type="TextInput"/>
	<max label="Maximum bereik" type="TextInput"/>
	<target label="Doel ID" type="TextInput" optional="true" deprecated="Deze eigenschap is verouderd. Gebruik het drop-down menu Doel-ID om in plaats daarvan de doelstap te selecteren. De ID die in dit veld is ingevoerd, blijft werken totdat het drop-down menu wordt gebruikt."/>
	<targetNew label="Doel ID" type="pageList" listTarget="1" defaultValue="" mandatory="true"/>
	<resultTxt label="Opgeslagen resultaat tekst" type="TextArea" height="100" optional="true" tooltip="Slaat tekst gerelateerd aan dit antwoord toe om bij de reslutaten te gebruiken. Deze tekst verschijnt alleen bij de reslutaten als 'Samenvoegen opgeslagen resultaten' (optionele eigenschap) is toegevoegd."/>
	<displayTxt label="Tekst voortgang" type="TextArea" height="100" optional="true" tooltip="Voegt extra tekst to aan de Intro tekst. Alle voortgangsteksten blijven zichtbaar tijdens de vervolgstappen tot de 'Verwijder voortgangs tekst' (optionele eigenschap) wordt gebruikt."/>
	<clear label="Verwijder tekst voortgang" type="CheckBox" optional="true" tooltip="Verwijderd alle voortgangsteksten die in vorige stappen zijn toegevoegd."/>
	
	<info><![CDATA[Zorg ervoor dat de Doel ID overeenkomt met de Unieke ID van de vraag, resultaat of informatie stap.]]></info>
