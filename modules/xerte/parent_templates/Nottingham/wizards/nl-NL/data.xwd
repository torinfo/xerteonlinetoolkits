		<headerTextColor type="ColourPicker" label="Header titelkleur" defaultValue="" optional="true" tooltip="Wijzig de kleur van de headertekst alleen voor deze pagina. Let op: dit overschrijft niet een kleur die rechtstreeks op de titels is toegepast."/>
    </pageHeaderGroup><milestone label="Mijlpaal" type="CheckBox" defaultValue="true" optional="true" tooltip="Maak van deze pagina een mijlpaal die op de voortgangsbalk wordt gemarkeerd." common="true"/></QRcode><SictTimeline menu="Media" menuItem="Tijdlijn media" icon="icTimeline" hint="Een tijdlijnpagina die is opgebouwd uit diverse secties. Tekst, video, afbeeldingen en audio kunnen toegevoegd worden." thumb="thumbs/sictTimeline.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#tijdlijnmedia" wiki="https://xerte.org.uk/wiki/doku.php?id=media_timeline_media_page" remove="true">
        <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
