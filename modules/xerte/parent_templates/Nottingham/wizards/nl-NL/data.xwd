    <audio label="Audio bestand" type="Media" placeholder="Selecteer een audio bestand"/>
	<answer label="Tekst antwoord" type="TextArea" height="200" placeholder="Voeg hier een antwoord toe"/>
  </nestedDictation><documentation menu="Interactiviteit" menuItem="Formulier" icon="icForm" remove="true" thumb="thumbs/documentation.jpg" example="https://xot.xerte.org.uk/play_164?hide=bottom#formulier" wiki="https://xerte.org.uk/wiki/doku.php?id=interactivity_documentation" hint="Toevoegen beschrijving pagina.">
    <name label="Pagina titel" type="TextInput" wysiwyg="true"/>
    <text label="Pagina tekst" type="TextArea" height="120" placeholder="Voeg paginatekst toe"/>
	<intro label="Introductie tekst" type="TextArea" height="120" placeholder="Voeg hier introductie tekst toe"/>
	<display label="Toon info document" data="separate,first,all" type="ComboBox" options="Op extra pagina,Alleen op eerste pagina,Op alle pagina's" width="120"/>
	<download label="Toon download knop" data="last,extra" type="ComboBox" options="Op de laatste pagina,Op extra pagina" width="120"/>
	<panelWidth label="Paneelbreedte" options="Klein,Medium,Groot,Volledig" type="ComboBox" data="Small,Medium,Large,Full" defaultValue="Medium" width="100" mandatory="true"/>

	<track label="inleverknop" type="CheckBox" optional="true" defaultValue="true" conditionTrigger="true" tooltip="Voegt een knop toe waarmee antwoorden naar de resultatenpagina worden verzonden"/>
	<showDownload label="Download knop" type="CheckBox" optional="true" defaultValue="true" conditionTrigger="true" tooltip="De downloadknop wordt standaard getoond. Schakel deze optie uit om de downloadknop te verbergen."/>
	<trackingWeight condition="track=='true'" label="Tracking score weging" optional="true" type="textInput" width="120" defaultValue="0.0"/> 
	
    <filename condition="showDownload!='false'" label="Bestandsnaam (zonder extensie)" type="TextInput" defaultValue="Voeg bestandsnaam toe" optional="true"/>
	<fileOrientation condition="showDownload!='false'" label="Bestand ori&#xEB;ntatie" data="portrait,landscape" type="ComboBox" options="Portret,Landschap" width="120" defaultValue="portrait" optional="true" tooltip="Ori&#xEB;ntatie van gedownload bestand"/>

	<fontSize condition="showDownload!='false'" type="group" label="Grootte font" optional="true" tooltip="Pas de lettergroottes aan die in het gedownloade document worden gebruikt">
		<h1 label="h1" type="TextInput" defaultValue="20" width="100" optional="true"/>
		<h2 label="h2" type="TextInput" defaultValue="18" width="100" optional="true"/>
		<h3 label="h3" type="TextInput" defaultValue="16" width="100" optional="true"/>
		<p label="p" type="TextInput" defaultValue="15" width="100" optional="true"/>
    </fontSize>

	<instructions label="Download instructies" type="TextArea" height="120" language="true"/>
	<submittedTxt label="Ingeleverde tekst" type="TextInput" language="true" defaultValue="Jouw antwoorden zijn verzonden" mandatory="true"/>
    <notAnswered label="Tekst niet geantwoord" type="TextInput" language="true"/>
	<requiredTxt label="Foutmelding niet compleet" type="TextInput" language="true"/>
	<downloadTxt label="Label downloadknop" type="TextInput" condition="showDownload!='false'" language="true"/>
	<submitTxt label="Label inleverknop" type="TextInput" condition="track=='true'" language="true"/>
	<nextTxt label="Label volgende knop" type="TextInput" language="true"/>
	<prevTxt label="Label vorige knop" type="TextInput" language="true"/>
	
    <newNodes>
      <page><![CDATA[<page name="Voeg titel van de sub-pagina toe" text=""/>]]></page>
	</newNodes>
	
