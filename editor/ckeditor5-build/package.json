{
  "name": "xerte-ckeditor5-build",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:fontawesome": "node scripts/generate-fontawesome-icons.mjs",
    "build": "npm run generate:fontawesome && webpack --mode production --config webpack.config.js && node scripts/copy-translations.mjs",
    "test": "node --test tests/*.test.js",
    "test:all": "node ../../tests/run-javascript-tests.cjs",
    "check": "npm run build && npm run test:all"
  },
  "devDependencies": {
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.2.2",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "raw-loader": "^4.0.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "postcss-nesting": "^13.0.2"
  },
  "dependencies": {
    "ckeditor5": "49.1.0",
    "axe-core": "^4.11.0"
  }
}
